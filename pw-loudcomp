# check if sound can be played and the sound theme that it should use
function _check_sound() {
    # shellcheck disable=SC2154
    if command -v play >/dev/null; then
        sound_available=true

        read -r sound_theme < <(kreadconfig6 --file kdeglobals --group Sounds --key Theme 2>/dev/null) || :

        if [[ -z "${sound_theme:-}" ]]; then
            if [[ "${XDG_CURRENT_DESKTOP:-}" == "KDE" ]]; then
                sound_theme="ocean"
            else
                sound_theme="freedesktop"
            fi
        fi
    elif [[ "$play_sound" == "true" ]]; then
        if [[ "${FUNCNAME[1]}" == "_start_daemon" ]]; then
            _print_log "warn" "sox '${MAGENTA}play${RESET}' command not found, ${BOLD}no sound will play${RESET}"
        else
            _print_message "stderr" "No sound will play" "sox '${MAGENTA}play${RESET}' command not found"
        fi
    fi
}


# check if config file exists or not then ask to create or overwrite
function _check_config() {
    trap "printf '\nOperation cancelled\n'; exit 130" INT TERM

    if [[ -f "$config_filepath" ]]; then
        printf 'Found config at %c%b%s%b%c\n' "'" "$BOLD" "$config_filepath" "$RESET" "'"
        printf 'Do you want to overwrite it? [%by%b/%bN%b] ' "$GREEN" "$RESET" "$RED" "$RESET"
        read -r answer
        if [[ "$answer" =~ ^[Yy]$ ]]; then
            _create_config "$config_filepath"
            printf 'Config created at %c%b%s%b%c\n' "'" "$GREEN" "$config_filepath" "$RESET" "'"
            printf 'Please edit the config to have the most accurate results\n'
        else
            printf 'OK!\n'
            return 0
        fi
    else
        printf 'Do you want to create a config? [%bY%b/%bn%b] ' "$GREEN" "$RESET" "$RED" "$RESET"
        read -r answer
        if [[ ! "$answer" =~ ^[Nn]$ ]]; then
            _create_config "$config_filepath"
            printf 'Config created at %c%b%s%b%c\n' "'" "$GREEN" "$config_filepath" "$RESET" "'"
            printf 'Please edit the config to have the most accurate results\n'
        else
            printf 'OK!\n'
            return 0
        fi
    fi
}


