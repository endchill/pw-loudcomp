#!/usr/bin/env bash

set -eu -o pipefail
shopt -s extglob

trap '_clean_up; exit 1' USR1


if [[ "${CLICOLOR_FORCE:-}" -eq 1 ]] || { [[ "${CLICOLOR:-}" -eq 1 ]] && [[ -t 1 ]]; }; then
    RESET="\033[0m"; BOLD="\033[1m"; RED="\033[31m"; GREEN="\033[32m"; YELLOW="\033[33m"; BLUE="\033[34m"; CYAN="\033[36m"
else
    RESET=""; BOLD=""; RED=""; GREEN=""; YELLOW=""; BLUE=""; CYAN=""
fi


[[ "$EUID" -eq 0 ]] && { printf 'Do %bNOT%b run this script as root.\n' "$RED" "$RESET" >&2; exit 1; }


name="$(basename "$0")"
is_switch=false

runtime_dir="${XDG_RUNTIME_DIR:-"/tmp/user-$UID"}/$name"
config_dir="${XDG_CONFIG_HOME:-"$HOME/.config"}/$name"
data_dir="${XDG_DATA_HOME:-"$HOME/.local/share"}/$name"

socket_filepath="$runtime_dir/state.sock"
settings_filepath="$config_dir/settings.env"
state_filepath="$data_dir/state.env"
ready_filepath="$data_dir/ready.lua"
get_new_device_id_filepath="$data_dir/get_new_device_id.lua"
lsp_config_filepath="${XDG_CONFIG_HOME:-"$HOME/.config"}/pipewire/pipewire.conf.d/loudcomp-sink.conf"


function _help() {
    printf '%b\n' "$(cat << EOF
${BOLD}${RED}Commands:${RESET}
    ${GREEN}start-daemon${RESET}                Starts the daemon if it is not running; it is recommended to use the systemd service instead.
    ${GREEN}stop-daemon${RESET}                 Stops the daemon if it is running; it is recommended to use the systemd service instead.
    ${GREEN}start-socket${RESET}                Starts the socket if it is not running; it is recommended to use the systemd socket instead.
    ${GREEN}stop-socket${RESET}                 Stops the socket if it is running; it is recommended to use the systemd socket instead.
    ${GREEN}reload${RESET}                      Manually reloads the configuration instead of restarting the daemon.
    ${GREEN}create-config${RESET}               Manually creates a configuration file.

    ${GREEN}set-input-gain${RESET}   ${YELLOW}<value>${RESET}    Sets an input gain value or increases or decreases it.
    ${GREEN}set-volume${RESET}       ${YELLOW}<value>${RESET}    Sets a volume value or increases or decreases it.
    ${GREEN}set-mute-state${RESET}   ${YELLOW}<state>${RESET}    Specifies whether to mute or unmute the output device.
    ${GREEN}set-curve-state${RESET}  ${YELLOW}<state>${RESET}    Specifies whether to enable or disable the correction curve.

    ${GREEN}-h, --help${RESET}                  Displays this help message.
    ${GREEN}set <property> <raw_value>${RESET}  Directly sets values for any LSP loudness compensation symbol parameter.

${BOLD}${RED}Arguments:${RESET}
    ${GREEN}2(+/-)${RESET}                      Sets an exact value                        ${CYAN}(volume, input gain)${RESET}
    ${GREEN}2%(+/-)${RESET}                     Increases or decreases the value relatively${CYAN}(volume, input gain)${RESET}
    ${GREEN}1/0/toggle${RESET}                  Sets a state                               ${CYAN}(mute-state, curve-state)${RESET}
EOF
)"
}


function _try_message() {
    printf $'Try \'%b%s --help%b\' for more information.\n' >&2 "$RED" "$name" "$RESET"
}


function _is_running_message() {
    printf 'Operation failed.\n' >&2
    printf 'Is the daemon running?\n' >&2
}


function _check_config() {
    trap "printf '\nOperation cancelled.\n'; exit 0" INT TERM
    if [[ -e "$settings_filepath" ]]; then
        printf $'Found config at \'%b%s%b\'\n' "$BLUE" "$settings_filepath" "$RESET"
        printf 'Do you want to overwrite it? [%by%b/%bN%b] ' "$GREEN" "$RESET" "$RED" "$RESET"
        read -r awnser
        if [[ "$awnser" =~ ^[Yy]$ ]]; then
            _create_config
            printf $'Config created at \'%b%s%b\'\n' "$GREEN" "$settings_filepath" "$RESET"
            printf 'Please edit the config to have the most accurate results.\n'
        else
            printf 'Operation cancelled.\n'
        fi
    else
        printf 'Do you want to create a config? [%bY%b/%bn%b] ' "$GREEN" "$RESET" "$RED" "$RESET"
        read -r awnser
        if [[ ! "$awnser" =~ ^[Nn]$ ]]; then
            _create_config
            printf $'Config created at \'%b%s%b\'\n' "$GREEN" "$settings_filepath" "$RESET"
            printf 'Please edit the config to have the most accurate results.\n'
        else
            printf 'Operation cancelled.\n'
        fi
    fi
}


function _create_config() {
    cat << EOF > "$settings_filepath"
# See 'man 5 pw-loudcomp' for more infomation

input_gain=0
listening_volume=83
# volume_curve_exponent=2.5

processing_mode=1
fft_quality=1
iir_approx=2
curve=4

is_clipping=0
clipping_range=6

output_device="auto"
output_device_fallback="none"

system_transfer=false
system_fallback=false
auto_adjust_volume=false
auto_reload=false
auto_switch=false

highest_input_gain_limit=
lowest_input_gain_limit=
highest_volume_limit=
lowest_volume_limit=
EOF
}


function _save_state() {
    sed -i "s|^$1=.*|$1=${!1}|" "$state_filepath"
}


function _send_state() {
    for fifo_filepath in "$runtime_dir"/*; do
        [[ -p "$fifo_filepath" ]] || continue
        jq -cn \
            --argjson outputID                  "$output_id"                                  \
            --argjson inputGain                 "$input_gain"                                 \
            --argjson volume                    "$volume"                                     \
            --argjson muteState                 "$mute_state"                                 \
            --argjson curveState                "$curve_state"                                \
            --argjson listeningVolume           "$listening_volume"                           \
            --arg     highestInputGain          "${highest_input_gain_limit:-N/A}"            \
            --arg     lowestInputGain           "${lowest_input_gain_limit:-N/A}"             \
        '{
            outputId:                            $outputID,
            inputGain:                           $inputGain,
            volume:                              $volume,
            muteState:                           $muteState,
            curveState:                          $curveState,
            listeningVolume:                     $listeningVolume,
            highestInputGain:                    ($highestInputGain | tonumber? // $highestInputGain),
            lowestInputGain:                     ($lowestInputGain | tonumber? // $lowestInputGain)
        }' > "$fifo_filepath" &
    done
}


function _set_input_gain() {
    local previous_input_gain
    previous_input_gain="$(awk -v input_gain="$input_gain" 'BEGIN {printf "%.0f\n", input_gain}')"

    if [[ -n "${highest_input_gain_limit:-}" && "$1" -ge "$highest_input_gain_limit" ]]; then
        input_gain="$highest_input_gain_limit"
    elif [[ -n "${lowest_input_gain_limit:-}" && "$1" -le "$lowest_input_gain_limit" ]]; then
        input_gain="$lowest_input_gain_limit"
    else
        input_gain="$1"
    fi

    raw_input_gain=$(awk -v input_gain="$input_gain" 'BEGIN {printf "%.6f", (10 ^ (input_gain} / 20))}')


    if [[ "$auto_adjust_volume" == true ]]; then
        local calculated_relative_volume="$((previous_input_gain-input_gain))"
        if  [[ "$calculated_relative_volume" -eq 0 ]]; then
            :
        elif [[ "$calculated_relative_volume" -gt 0 ]]; then
            _set_relative_volume "$calculated_relative_volume" "+"
        elif [[ "$calculated_relative_volume" -lt 0 ]]; then
            _set_relative_volume "${calculated_relative_volume#-}" "-"
        fi
    fi


    pw-cli set-param "$loudcomp_node_id" 2 "{ \"params\": [ \"loudcomp:input\", $raw_input_gain ] }"
    _send_state
    _save_state "raw_input_gain"

    if [[ "$is_custom_input_gain" == true ]]; then
        sed -i "s|^$custom_input_gain=.*|$custom_input_gain=$input_gain|" "$settings_filepath"
    else
        sed -i "s|^input_gain=.*|input_gain=$input_gain|" "$settings_filepath"
    fi
}


function _set_volume() {
    if [[ "$1" -gt "$highest_volume_limit" ]]; then
        volume="$highest_volume_limit"
    elif [[ "$1" -lt "$lowest_volume_limit" ]]; then
        volume="$lowest_volume_limit"
    else
        volume="$1"
    fi

    raw_volume="$(awk -v volume="$volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.6f", 20 * log((volume / 100) ^ vce) / log(10)}')"
    [[ "$raw_volume" == "-inf" ]] && raw_volume=-83

    pw-cli set-param "$loudcomp_node_id" 2 "{ \"params\": [ \"loudcomp:volume\", $raw_volume ] }"
    _send_state
    _save_state "raw_volume"
}


function _set_relative_input_gain() {
    local absolute_input_gain
    if [[ "$2" == "+" ]]; then
        absolute_input_gain="$((input_gain+$1))"
    else
        absolute_input_gain="$((input_gain-$1))"
    fi

    _set_input_gain "$absolute_input_gain"
}


function _set_relative_volume() {
    if [[ "$2" == "+" ]]; then
        volume="$((volume+$1))"
    else
        volume="$((volume-$1))"
    fi

    _set_volume "$volume"
}


function _set_mute_state() {
    local value="$1"

    if [[ "$value" == "toggle" ]]; then
        if [[ "$mute_state" -eq 1 ]]; then
            value=0
        else
            value=1
        fi
    fi

    mute_state="$value"

    wpctl set-mute "$output_id" "$mute_state"
    _send_state
    _save_state "mute_state"
}


function _set_curve_state() {
    if [[ "$1" == "toggle" ]]; then
        if [[ "$curve_state" -eq "$curve" ]]; then
            curve_state=0
        else
            curve_state="$curve"
        fi
    elif [[ "$1" -eq 1 ]]; then
        curve_state="$curve"
    else
        curve_state=0
    fi


    pw-cli set-param "$loudcomp_node_id" 2 "{ \"params\": [ \"loudcomp:std\", $curve_state ] }"
    _send_state
    _save_state "curve_state"
}


function _start_socket() {
    coproc socket {
        socat UNIX-LISTEN:"$socket_filepath",fork EXEC:"$0 _socket_handler"
    }
    printf '%s\n' "$socket_PID" > "$runtime_dir/socket_pid"
}


function _socket_handler() {
    fifo_filepath="$runtime_dir/$$"
    mkfifo "$fifo_filepath"
    trap 'rm -f "$fifo_filepath"' EXIT
    exec 3<> "$fifo_filepath"
    cat <&3 &

    printf '_send_state\n' > "$runtime_dir/command_handler"
    writer_state="$!"
    cat >/dev/null
    kill "$writer_state" 2>/dev/null
    wait "$writer_state" 2>/dev/null
}


function _stop_socket() {
    kill -0 "$socket_PID" 2>/dev/null && pkill -P -SIGTERM "$socket_PID" && kill -SIGTERM "$socket_PID"
    for pipe in "$runtime_dir"/*;do
        [[ -p "$pipe" ]] && rm -f "$pipe"
    done
}


function _connect_nodes() {
    # while read -r line; do
    #     if [[ "$line" == "ready" ]]; then
    #         sleep 0.1s
            pw-link -P "${loudcomp_node_description}:output_FL" "${output_name}:playback_FL"
            pw-link -P "${loudcomp_node_description}:output_FR" "${output_name}:playback_FR"
            # break
        # fi
    # done < <(stdbuf -oL wpexec "$data_dir/ready.lua")
}


function _disconnect_nodes() {
    set +e
    pw-link -d "${loudcomp_node_description}:output_FL" "${output_name}:playback_FL" 2>/dev/null
    pw-link -d "${loudcomp_node_description}:output_FR" "${output_name}:playback_FR" 2>/dev/null
    set -e
}


function _reload_config() {
    source "$settings_filepath"
    source "$state_filepath"


    [[ -z "${highest_volume_limit:-}" || "${highest_volume_limit:-}" -gt 100 ]] && highest_volume_limit=100
    [[ -z "${lowest_volume_limit:-}"  || "${lowest_volume_limit:-}"  -lt 0   ]] && lowest_volume_limit=0

    [[ "$volume" -gt "$highest_volume_limit" ]] && volume="$highest_volume_limit"
    [[ "$volume" -lt "$lowest_volume_limit"  ]] && volume="$lowest_volume_limit"

    raw_volume="$(awk -v volume="$volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.6f", 20 * log((volume / 100) ^ vce) / log(10)}')"
    [[ "$raw_volume" == "-inf" ]] && raw_volume=-83

    _send_state
    _save_state "raw_volume"


    if [[ "$output_device" == "auto" && "$is_switch" == true && "${switch_device:-}" != "$last_output_device" ]]; then
        output_device="$switch_device"
        is_switch=false
    else
        wpctl set-default "$loudcomp_node_id"
        wpctl set-volume "$loudcomp_node_id" 1.0
    fi

    if [[ "$output_device" != "$last_output_device" ]]; then
        if [[ "$output_device" == "auto" ]]; then
            eval "$(wpctl list | awk '/audio\/sink.*\*/ {
                printf "output_name=%s\n", $2
                printf "output_id=%s\n", $1
            }')"
        else
            if wpctl list | grep "$output_device" >/dev/null; then
                output_name="$output_device"
                output_id="$(wpctl list | awk -v output_device="$output_device" '$2 ~ output_device {print $1}')"
            else
                if [[ "$output_device_fallback" == "none" ]]; then
                    printf '%b%s%b device not found.\n' "$RED" "$output_device" "$RESET"
                    _clean_up
                    exit 1
                elif [[ "$output_device_fallback" == "auto" ]]; then
                    eval "$(wpctl list | awk '/audio\/sink.*\*/ {
                        printf "output_name=%s\n", $2
                        printf "output_id=%s\n", $1
                    }')"
                else
                    if wpctl list | grep "$output_device_fallback" >/dev/null; then
                        output_name="$output_device_fallback"
                        output_id="$(wpctl list | awk -v output_device_fallback="$output_device_fallback" '$2 ~ output_device_fallback {print $1}')"
                    else
                        printf '%b%s%b fallback device not found.\n' "$RED" "$output_device_fallback" "$RESET"
                        _clean_up
                        exit 1
                    fi
                fi
            fi
        fi

        if [[ "$system_transfer" == true ]]; then
            output_volume="$(awk -v input_gain="$input_gain" -v raw_volume="$raw_volume" 'BEGIN {printf "%.2f\n", (10 ^ ((input_gain + raw_volume) / 60))}')"
            wpctl set-volume "$last_output_id" "$output_volume"
            wpctl set-mute "$last_output_id" "$mute_state"
        fi

        output_volume="$(wpctl get-volume "$output_id" | awk '{print $2}')"
        _save_state "output_volume"


        if [[ "$system_transfer" == true ]]; then
            if wpctl get-volume "$output_id" | grep '[MUTED]'; then
                mute_state=1
            else
                mute_state=0
            fi
        fi

        last_output_device="$output_name"
        last_output_id="$output_id"
        sanitized_name="${output_name//[-.]/_}"
        custom_input_gain="${sanitized_name}_input_gain"

        wpctl set-default "$loudcomp_node_id"
        wpctl set-volume "$loudcomp_node_id" 1.0
        wpctl set-volume "$output_id" 1.0
        sleep 0.05s

        wpctl set-mute "$output_id" "$mute_state"
    fi


    if [[ -v "$custom_input_gain" ]]; then
        input_gain="${!custom_input_gain}"
        is_custom_input_gain=true
    else
        is_custom_input_gain=false
    fi

    input_gain="$((input_gain+listening_volume-83))"


    pw-cli set-param "$loudcomp_node_id" 2 "{ \"params\": [ \"loudcomp:input\", $raw_input_gain, \"loudcomp:mode\", $processing_mode, \"loudcomp:fft\", $fft_quality, \"loudcomp:approx\", $iir_approx, \"loudcomp:std\", $curve, \"loudcomp:hclip\", $is_clipping, \"loudcomp:hcrange\", $clipping_range, \"loudcomp:volume\", $raw_volume ] }"
}


function _reload() {
    _disconnect_nodes
    _reload_config
    _connect_nodes
}


function _switch() {
    if [[ "$1" =~ ^[0-9]+$ ]]; then
        switch_device="$(wpctl list | awk -v output_id="$1" '$1 ~ output_id {print $2}')"
    else
        switch_device="$1"
    fi
    is_switch=true
    _reload
}


function _auto_reload() {
    coproc auto_reload {
        while read -r dirpath _ filename; do
            if [[ "${dirpath}${filename}" == "$settings_filepath" ]]; then
                printf '_reload\n' > "$runtime_dir/command_handler"
            fi
        done < <(inotifywait -q -m -e close_write "$config_dir")
    }
}


function _auto_switch() {
    coproc auto_switch {
        while read -r id; do
            if [[ -n "$id" ]]; then
                printf '_switch %d\n' "$id" > "$runtime_dir/command_handler"
            fi
        done < <(stdbuf -oL wpexec "$data_dir/get_new_device_id.lua")
    }
}


function _clean_up() {
    trap - EXIT INT TERM USR1

    [[ -n "${output_id:-}" ]] && wpctl set-mute "$output_id" 1


    (: >&3) 2>/dev/null && exec 3>&-
    kill -0 "${auto_reload_PID:-}" 2>/dev/null && pkill -P "$auto_reload_PID" && kill "$auto_reload_PID"
    kill -0 "${auto_switch_PID:-}" 2>/dev/null && pkill -P "$auto_switch_PID" && kill "$auto_switch_PID"


    if [[ -n "${output_id:-}" ]]; then
        if [[ "$system_transfer" == true ]]; then
            output_volume="$(awk -v input_gain="$input_gain" -v raw_volume="$raw_volume" 'BEGIN {printf "%.2f\n", (10 ^ ((input_gain + raw_volume) / 60))}')"
            wpctl set-volume "$output_id" "$output_volume"
            wpctl set-mute "$output_id" "$mute_state"
        fi

        wpctl set-default "$output_id"
    fi

    _disconnect_nodes

    [[ -d "$runtime_dir" ]] && rm -rf "$runtime_dir"/!(state.sock)
}


function _start_daemon() {
    trap "_clean_up; exit 0" EXIT INT TERM

    if [[ -f "$settings_filepath" ]]; then
        source "$settings_filepath"
    else
        printf 'Config not found.\n' >&2
        printf $'Did you try running \'%b%s create-config%b\'?\n' >&2  "$RED" "$name" "$RESET"
        exit 1
    fi


    [[ ! -e "$runtime_dir"    ]] && mkdir -p "$runtime_dir"
    [[ ! -e "$data_dir"       ]] && mkdir -p "$data_dir"

    [[ ! -f "$state_filepath" ]] && cat << EOF > "$state_filepath"
output_volume=
mute_state=0
curve_state=4
raw_input_gain=
raw_volume=-47
EOF

    [[ ! -f "$ready_filepath" ]] && cat << EOF > "$ready_filepath"
node_om = ObjectManager {
    Interest {
        type = "node",
        Constraint { "node.name", "equals", "$loudcomp_node_description" }
    }
}

node_om:connect("object-added", function (om, node)
    print("ready")
end)

node_om:activate()
EOF

    [[ ! -f "$get_new_device_id_filepath" ]] && cat << EOF > "$get_new_device_id_filepath"
local nodes_om = ObjectManager {
    Interest {
        type = "node",
        Constraint { "media.class", "matches", "Audio/Sink", type = "pw-global" },
        Constraint { "node.description", "!", "$loudcomp_node_description" },
    }
}

local metadata_om = ObjectManager {
    Interest {
        type = "metadata",
        Constraint { "metadata.name", "=", "default" },
    }
}

local function find_node_id(node_name)
    for node in nodes_om:iterate() do
        if node.properties["node.name"] == node_name then
            return node["bound-id"]
        end
    end
    return nil
end

metadata_om:connect("object-added", function(om, metadata)
    metadata:connect("changed", function(m, subject, key, value_type, value)
        if key == "default.configured.audio.sink" then
            local ok, parsed = pcall(function() return Json.Raw(value):parse() end)
            if ok and parsed and parsed.name then
                local id = find_node_id(parsed.name)
                if id then
                    print(id)
                end
            end
        end
    end)
end)

nodes_om:activate()
metadata_om:activate()
EOF

    [[ ! -f "$lsp_config_filepath" ]] && cat << EOF > "$lsp_config_filepath" && restart_pipewire=true
context.modules = [
    { name = libpipewire-module-filter-chain
      args = {
          node.description = "LSP Loudness Compensator"
          media.name = "lsp-loudness-compensator"
          filter.graph = {
              nodes = [
                  {
                      type = lv2
                      name = loudcomp
                      plugin = "http://lsp-plug.in/plugins/lv2/loud_comp_stereo"
                  }
              ]
          }
          capture.props = {
              node.name = "effect_input.loudcomp"
              media.class = "Audio/Sink"
              channelmix.lock-volumes = true
              audio.channels = 2
              audio.position = [ FL FR ]
          }
          playback.props = {
              node.name = "effect_output.loudcomp"
              channelmix.lock-volumes = true
              node.autoconnect = false
              node.passive = true
              audio.channels = 2
              audio.position = [ FL FR ]
          }
      }
    }
]
EOF


    sed -i 's/^# //' "$lsp_config_filepath"

    if [[ "${restart_pipewire:-}" == true ]]; then
        if systemctl --user list-unit-files pipewire-pulse.service >/dev/null; then
            systemctl --user restart pipewire.service pipewire-pulse.service wireplumber.service
            sleep 8s
        else
            systemctl --user restart pipewire.service wireplumber.service
            sleep 8s
        fi
    fi

    source "$settings_filepath"
    source "$state_filepath"


    if [[ "$output_device" == "auto" ]]; then
        eval "$(wpctl list | awk '/audio\/sink.*\*/ {
            printf "output_name=%s\n", $2
            printf "output_id=%s\n", $1
        }')"
    else
        if wpctl list | grep "$output_device" >/dev/null; then
            output_name="$output_device"
            output_id="$(wpctl list | awk -v output_device="$output_device" '$2 ~ output_device {print $1}')"
        else
            if [[ "$output_device_fallback" == "none" ]]; then
                printf '%b%s%b device not found.\n' "$RED" "$output_device" "$RESET"
                _clean_up
                exit 1
            elif [[ "$output_device_fallback" == "auto" ]]; then
                eval "$(wpctl list | awk '/audio\/sink.*\*/ {
                    printf "output_name=%s\n", $2
                    printf "output_id=%s\n", $1
                }')"
            else
                if wpctl list | grep "$output_device_fallback" >/dev/null; then
                    output_name="$output_device_fallback"
                    output_id="$(wpctl list | awk -v output_device_fallback="$output_device_fallback" '$2 ~ output_device_fallback {print $1}')"
                else
                    printf '%b%s%b fallback device not found.\n' "$RED" "$output_device_fallback" "$RESET"
                    _clean_up
                    exit 1
                fi
            fi
        fi
    fi


    last_output_device="$output_name"
    last_output_id="$output_id"
    sanitized_name="${output_name//[-.]/_}"
    custom_input_gain="${sanitized_name}_input_gain"

    if [[ -v "$custom_input_gain" ]]; then
        input_gain="${!custom_input_gain}"
        is_custom_input_gain=true
    else
        is_custom_input_gain=false
    fi

    input_gain="$((input_gain+listening_volume-83))"


    loudcomp_node_description="LSP Loudness Compensator"
    loudcomp_node_name="${loudcomp_node_description// /-}"
    loudcomp_node_name="${loudcomp_node_name,,}"


    output_volume="$(wpctl get-volume "$output_id" | awk '{print $2}')"
    _save_state "output_volume"


    if [[ "$system_transfer" == true ]]; then
        if wpctl get-volume "$output_id" | grep '[MUTED]'; then
            mute_state=1
        else
            mute_state=0
        fi
    fi


    wpctl set-mute "$output_id" 1


    if [[ "$system_transfer" == true ]]; then
        raw_volume="$(awk -v output_volume="$output_volume" -v input_gain="$input_gain" 'BEGIN {printf "%.0f\n", ((60 * ( log(output_volume) / log(10))) - input_gain)}')"
    else
        raw_volume="$(awk -v raw_volume="$raw_volume" 'BEGIN {printf "%.0f\n", raw_volume')"
    fi

    [[ "$raw_volume" == "-inf" ]] && raw_volume=-83


    volume="$(awk -v raw_volume="$raw_volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.0f", 100 * (10 ^ (raw_volume / (20 * vce)))}')"
    [[ -z "${highest_volume_limit:-}" || "${highest_volume_limit:-}" -gt 100 ]] && highest_volume_limit=100
    [[ -z "${lowest_volume_limit:-}"  || "${lowest_volume_limit:-}"  -lt 0   ]] && lowest_volume_limit=0
    [[ "$volume" -gt "$highest_volume_limit" ]] && { volume="$highest_volume_limit"; raw_volume="$(awk -v volume="$volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.6f", 20 * log((volume / 100) ^ vce) / log(10)}')"; }
    [[ "$volume" -lt "$lowest_volume_limit"  ]] && { volume="$lowest_volume_limit"; raw_volume="$(awk -v volume="$volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.6f", 20 * log((volume / 100) ^ vce) / log(10)}')"; }


    mkfifo "$runtime_dir/command_handler"
    exec 3<> "$runtime_dir/command_handler"

    loudcomp_node_id="$(pw-dump | jq -r '.[] | select(.type=="PipeWire:Interface:Node") | select(.info.props["node.name"]=="effect_input.loudcomp") | .info.props["object.serial"]')"


    _connect_nodes


    pw-cli set-param "$loudcomp_node_id" 2 "{ \"params\": [ \"loudcomp:input\", $raw_input_gain, \"loudcomp:mode\", $processing_mode, \"loudcomp:fft\", $fft_quality, \"loudcomp:approx\", $iir_approx, \"loudcomp:std\", $curve, \"loudcomp:hclip\", $is_clipping, \"loudcomp:hcrange\", $clipping_range, \"loudcomp:volume\", $raw_volume ] }"


    wpctl set-default "$loudcomp_node_id"
    wpctl set-volume "$loudcomp_node_id" 1.0
    wpctl set-volume "$output_id" 1.0
    sleep 0.05s

    wpctl set-mute "$output_id" "$mute_state"


    [[ "$auto_reload" == true ]] && _auto_reload
    [[ "$auto_switch" == true ]] && _auto_switch


    touch "$runtime_dir/pw-loudcomp.lock"
    _send_state

    systemd-notify READY=1

    while read -r cmd arg1 arg2; do
        case "$cmd" in
            "set")
                pw-cli set-param "$loudcomp_node_id" 2 "{ \"params\": [ \"loudcomp:$arg1\", $arg2 ] }"
            ;;
            "_set_relative_input_gain"|"_set_relative_volume"|"_set_input_gain"|"_set_volume"|"_set_mute_state"|"_set_curve_state"|"_stop_daemon"|"_start_socket"|"_stop_socket"|"_send_state"|"_reload"|"_switch")
                ${cmd} "$arg1" "$arg2"
            ;;
            *)
                printf 'Opiration failed.\n'
                printf '%s\n' "$cmd"
            ;;
        esac
    done <&3
}


function _stop_daemon() {
    exit 0
}


case "${1:-}" in
    "start-daemon")
        if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
            printf 'Operation failed.\n' >&2
            printf 'Daemon is already running.\n' >&2
            exit 1
        else
            _start_daemon
        fi
    ;;
    "stop-daemon")
        if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
            printf '_stop_daemon\n' > "$runtime_dir/command_handler"
            while read -r _ _ filename; do
                if [[ "$filename" == "pw-loudcomp.lock" ]]; then
                    exit 0
                fi
            done < <(inotifywait -q -m -e delete "$runtime_dir")
        else
            printf 'Operation failed.\n' >&2
            _is_running_message
            exit 1
        fi
    ;;
    "start-socket")
        if [[ ! -f "$runtime_dir/pw-loudcomp.lock" ]]; then
            _is_running_message
            exit 1
        elif [[ -S "$socket_filepath" ]]; then
            printf 'Operation failed.\n' >&2
            printf 'Socket is already socket running.\n' >&2
            exit 1
        else
            printf '_start_socket\n' > "$runtime_dir/command_handler"
            exit 0
        fi
    ;;
    "_socket_handler")
        _socket_handler
    ;;
    "stop-socket")
        if [[ -f "$runtime_dir/socket_pid" ]]; then
            printf '_stop_socket\n' > "$runtime_dir/command_handler"
            exit 0
        else
            printf 'Operation failed.\n' >&2
            printf 'Is the socket running?.\n' >&2
            exit 1
        fi
    ;;
    "reload")
        if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
            printf '_reload\n' > "$runtime_dir/command_handler"
            exit 0
        else
            _is_running_message
            exit 1
        fi
    ;;
    "set-input-gain")
        if [[ -z "${2:-}" ]]; then
            printf $'You have to specify a value.\n' >&2
            printf $'Try %b\'%s --help\'%b for more information.\n' "$RED" "$name" "$RESET" >&2
            exit 1
        elif [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
            if [[ "$2" =~ ^([0-9]+)%([+-])$ ]]; then
                printf '_set_relative_input_gain %s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" > "$runtime_dir/command_handler"
            elif [[ "$2" =~ ^(-?[0-9]+)$ ]]; then
                printf '_set_input_gain %s\n' "$2" > "$runtime_dir/command_handler"
            else
                printf $'Invalid format: \'%b%s%b\'\n' "$RED" "$2" "$RESET" >&2
                printf $'Try %b\'%s --help\'%b for more information.\n' "$RED" "$name" "$RESET" >&2
                exit 1
            fi
        else
            _is_running_message
            exit 1
        fi
    ;;
    "set-volume")
        [[ -n "$settings_filepath" ]] && source "$settings_filepath"
        if [[ -z "${2:-}" ]]; then
            printf $'You have to specify a value.\n' >&2
            printf $'Try %b\'%s --help\'%b for more information.\n' "$RED" "$name" "$RESET" >&2
            exit 1
        elif [[ "$2" =~ ^([0-9]+)%([+-])$ ]]; then
            if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                printf "_set_relative_volume %s %s\n" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" > "$runtime_dir/command_handler"
            elif [[ "${system_fallback:-}" == true ]]; then
                wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ "$2"
            else
                _is_running_message
                exit 1
            fi
        elif [[ "$2" =~ ^([0-9]+)$ ]]; then
            if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                printf "_set_volume %s\n" "$2" > "$runtime_dir/command_handler"
            elif [[ "${system_fallback:-}" == true ]]; then
                wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ "$2"
            else
                _is_running_message
                exit 1
            fi
        else
            printf $'Invalid format: \'%b%s%b\'\n' "$RED" "$2" "$RESET" >&2
            _try_message
            exit 1
        fi
    ;;
    "set-mute-state")
        [[ -n "$settings_filepath" ]] && source "$settings_filepath"
        if [[ -f "$runtime_dir/pw-loudcomp.lock" ]] || [[ "${system_fallback:-}" == true ]]; then
            if [[ -z "${2:-}" ]]; then
                printf 'You have to specify a value.\n' >&2
                exit 1
            elif [[ ! "$2" =~ ^(1|0|toggle)$ ]]; then
                printf $'Invalid format: \'%b%s%b\'\n' "$RED" "$2" "$RESET" >&2
                _try_message
                exit 1
            elif [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                printf '_set_mute_state %s\n' "$2" > "$runtime_dir/command_handler"
                exit 0
            else
                wpctl set-mute @DEFAULT_AUDIO_SINK@ "$2"
                exit 0
            fi
        else
            _is_running_message
            exit 1
        fi
    ;;
    "set-curve-state")
        if [[ -z "${2:-}" ]]; then
            printf 'You have to specify a value.\n' >&2
            exit 1
        elif [[ "$2" =~ ^(1|0|toggle)$ ]]; then
            if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                printf '_set_curve_state %s\n' "$2" > "$runtime_dir/command_handler"
                exit 0
            else
                _is_running_message
                exit 1
            fi
        else
            printf $'Invalid format: \'%b%s%b\'\n' "$RED" "$2" "$RESET" >&2
            _try_message
            exit 1
        fi
    ;;
    "set")
        if [[ -z "${3:-}" ]]; then
            printf 'You have to specify two values.\n' >&2
            _try_message
            exit 1
        else
            if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                printf 'set %s %s\n' "$2" "$3" > "$runtime_dir/command_handler"
            else
                _is_running_message
                exit 1
            fi
        fi
    ;;
    "create-config")
        _check_config
        exit 0
    ;;
    "--help"|"-h")
        _help
        exit 0
    ;;
    "")
        printf $'You have to specify a command.\n' >&2
        _try_message
        exit 1
    ;;
    *)
        printf $'Unknown command: \'%b%s%b\'\n' "$RED" "$1" "$RESET" >&2
        _try_message
        exit 1
    ;;
esac
