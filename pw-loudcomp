function _get_output_info() {
    wpctl_list="$(wpctl list)"

    read -r output_name output_id < <(awk '/audio\/sink.*\*/ { printf "%s\t%d\n", $2, $1 }' <<< "$wpctl_list") || :

    if [[ -z "$output_name" || -z "$output_id" ]]; then
        IFS=$'\t' read -r output_name output_id < <(while read -r id; do wpctl inspect "$id"; done < <(awk '/sink/ {print $1}' <<< "$wpctl_list") | awk -F '[ ,]' '
            /^id/ {id = $2; FS = "= "; $0 = $0}
            /node\.name/ {gsub(/^"+|"+$/, "", $2); name = $2 "\t" id}
            /priority.session/ { gsub(/^"+|"+$/, "", $2); list[$2] = name; FS = "[ ,]"; $0 = $0}
            END {PROCINFO["sorted_in"] = "@ind_num_desc"; for (score in list) {print list[score]; break}; }
        ')
    fi
}


function _save_state() {
    printf 'output_volume=%.2f\nmute_state=%d\ncurve_state=%d\nraw_input_gain=%.6f\nraw_volume=%.6f\n' "$output_volume" "$mute_state" "$curve_state" "$raw_input_gain" "$raw_volume" > "$data_dir/state.env"
}


function _send_state() {
    for fifo_filepath in "$runtime_dir"/*; do
        [[ -p "$fifo_filepath" && "$fifo_filepath" != "$runtime_dir/command_handler" ]] || continue

        printf '{"outputID": %d, "inputGain": %d, "volume": %d, "muteState": %d, "curveState": %d, "listeningVolume": %d, "highestInputGainLimit": %d, "lowestInputGainLimit": %d, "highestVolumeLimit": %d, "lowestVolumeLimit": %d}\n' "$output_id" "$global_input_gain" "$volume" "$mute_state" "$curve_state" "$listening_volume" "${highest_input_gain_limit:-$global_input_gain}" "${lowest_input_gain_limit:-$global_input_gain}" "${highest_volume_limit:-100}" "${lowest_volume_limit:-0}" > "$fifo_filepath" &
    done
}


function _set_input_gain() {
    local previous_input_gain
    local new_volume
    local auto_adjust_trigger
    previous_input_gain="$global_input_gain"

    if [[ -n "${highest_input_gain_limit:-}" && "$1" -ge "$highest_input_gain_limit" ]]; then
        global_input_gain="$highest_input_gain_limit"
    elif [[ -n "${lowest_input_gain_limit:-}" && "$1" -le "$lowest_input_gain_limit" ]]; then
        global_input_gain="$lowest_input_gain_limit"
    else
        global_input_gain="$1"
    fi

    raw_input_gain="$(awk -v input_gain="$global_input_gain" 'BEGIN {printf "%.6f\n", (10 ^ (input_gain / 20))}')"


    if [[ "${auto_adjust_volume:-}" == true ]]; then
        auto_adjust_trigger=true
        new_volume="$(awk -v volume="$volume" -v db_diff="$((previous_input_gain-global_input_gain))" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.0f\n", volume * (10 ^ (db_diff / (20 * vce)))}')"

        wpctl set-mute "$output_id" 1
        sleep 0.1s
        _set_volume "$new_volume"
    fi


    pw-cli set-param "$loudcomp_node_id" 2 "{ \"params\": [ \"loudcomp:input\", $raw_input_gain ] }"
    [[ "${auto_adjust_trigger:-}" == true ]] && wpctl set-mute "$output_id" 0
    { _send_state; _save_state; } &

    if [[ "$is_custom_input_gain" == true ]]; then
        settings_filepath_tmp="$(<"$config_dir/settings.env")"
        settings_filepath_tmp="${settings_filepath_tmp//${custom_input_gain}=*([!$nl])/${custom_input_gain}=${global_input_gain}}"
        printf '%s' "$settings_filepath_tmp" > "$config_dir/settings.env.tmp"
        mv "$config_dir/settings.env.tmp" "$config_dir/settings.env"
    else
        settings_filepath_tmp="$(<"$config_dir/settings.env")"
        settings_filepath_tmp="${settings_filepath_tmp//global_input_gain=*([!$nl])/global_input_gain=${global_input_gain}}"
        printf '%s' "$settings_filepath_tmp" > "$config_dir/settings.env.tmp"
        mv "$config_dir/settings.env.tmp" "$config_dir/settings.env"
    fi
}


function _set_volume() {
    if [[ "$1" -gt "$highest_volume_limit" ]]; then
        volume="$highest_volume_limit"
    elif [[ "$1" -lt "$lowest_volume_limit" ]]; then
        volume="$lowest_volume_limit"
    else
        volume="$1"
    fi

    raw_volume="$(awk -v volume="$volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.6f\n", 20 * log((volume / 100) ^ vce) / log(10)}')"
    [[ "$raw_volume" == "-inf"  ]] && raw_volume=-83

    pw-cli set-param "$loudcomp_node_id" 2 "{ \"params\": [ \"loudcomp:volume\", $raw_volume ] }" >/dev/null
    { _send_state; _save_state; } &
}


function _set_relative_input_gain() {
    local absolute_input_gain
    if [[ "$2" == "+" ]]; then
        absolute_input_gain="$((global_input_gain+$1))"
    else
        absolute_input_gain="$((global_input_gain-$1))"
    fi

    _set_input_gain "$absolute_input_gain"
}


function _set_relative_volume() {
    if [[ "$2" == "+" ]]; then
        volume="$((volume+$1))"
    else
        volume="$((volume-$1))"
    fi

    _set_volume "$volume"
}


function _set_mute_state() {
    local value="$1"

    if [[ "$value" == "toggle" ]]; then
        if [[ "$mute_state" -eq 1 ]]; then
            value=0
        else
            value=1
        fi
    fi

    mute_state="$value"

    wpctl set-mute "$output_id" "$mute_state"
    { _send_state; _save_state; } &
}


function _set_curve_state() {
    if [[ "$1" == "toggle" ]]; then
        if [[ "$curve_state" -eq "$curve" ]]; then
            curve_state=0
        else
            curve_state="$curve"
        fi
    elif [[ "$1" -eq 1 ]]; then
        curve_state="$curve"
    else
        curve_state=0
    fi


    pw-cli set-param "$loudcomp_node_id" 2 "{ \"params\": [ \"loudcomp:std\", $curve_state ] }" >/dev/null
    { _send_state; _save_state; } &
}


function _start_socket() {
    coproc socket {
        socat UNIX-LISTEN:"$runtime_dir/state.sock",fork EXEC:"$0 _socket_handler"
    }
    printf '%s\n' "$socket_PID" > "$runtime_dir/socket_pid"
}


function _socket_handler() {
    fifo_filepath="$runtime_dir/$$"
    mkfifo "$fifo_filepath"
    trap 'rm "$fifo_filepath"' EXIT
    exec 3<> "$fifo_filepath"

    sleep 0.001s && printf '_send_state\n' > "$runtime_dir/command_handler"
    while read -r line; do
        printf '%s\n' "$line"
    done <&3

    (: >&3) 2>/dev/null && exec 3>&-
}


function _stop_socket() {
    if [[ -n "${socket_PID:-}" ]]; then
        _kill_with_children "$socket_PID"

        for pipe in "$runtime_dir"/*;do
            [[ -p "$pipe" ]] && rm "$pipe"
        done
    fi
}


function _connect_nodes() {
    while read -r line; do
        if [[ "$line" == "ready" ]]; then
            sleep 0.1s
            pw-link -P "${loudcomp_node_description}:output_FL" "${output_name}:playback_FL" 2>/dev/null || :
            pw-link -P "${loudcomp_node_description}:output_FR" "${output_name}:playback_FR" 2>/dev/null || :
            break
        fi
    done < <(stdbuf -oL wpexec "$data_dir/node_ready.lua")
}


function _disconnect_nodes() {
    pw-link -d "${loudcomp_node_description:-}:output_FL" "${output_name:-}:playback_FL" 2>/dev/null || :
    pw-link -d "${loudcomp_node_description:-}:output_FR" "${output_name:-}:playback_FR" 2>/dev/null || :
}


function _reload_config() {
    source "$config_dir/settings.env"
    source "$data_dir/state.env"

    if [[ -z "${highest_volume_limit:-}" || "${highest_volume_limit:-}" -gt 100 ]]; then
        highest_volume_limit=100
    elif [[ -z "${lowest_volume_limit:-}" || "${lowest_volume_limit:-}" -lt 0 ]]; then
        lowest_volume_limit=0
    fi

    if [[ "$volume" -gt "$highest_volume_limit" ]]; then
        volume="$highest_volume_limit"
    elif [[ "$volume" -lt "$lowest_volume_limit"  ]]; then
        volume="$lowest_volume_limit"
    fi

    raw_volume="$(awk -v volume="$volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.6f\n", 20 * log((volume / 100) ^ vce) / log(10)}')"
    [[ "$raw_volume" == "-inf" ]] && raw_volume=-83


    if [[ "$output_device" == "auto" && "${is_switch:-}" == true && "${switch_device:-}" != "$last_output_device" ]]; then
        output_device="$switch_device"
        is_switch=false
    else
        wpctl set-default "$loudcomp_node_id"
        wpctl set-volume "$loudcomp_node_id" 1.0
    fi

    if [[ "$output_device" != "$last_output_device" ]]; then
        wpctl_list="$(wpctl list)"

        if [[ "$output_device" == "auto" ]]; then
            _get_output_info
        else
            if grep --quiet "$output_device" <<< "$wpctl_list"; then
                output_name="$output_device"
                output_id="$(awk -v output_device="$output_device" '$2 == output_device {print $1}' <<< "$wpctl_list")"
            else
                if [[ "$output_device_fallback" == "none" ]]; then
                    printf '%b%s%b device not found\n' "$RED" "$output_device" "$RESET"
                    return 1
                elif [[ "$output_device_fallback" == "auto" ]]; then
                    _get_output_info
                else
                    if grep --quiet "$output_device_fallback" <<< "$wpctl_list"; then
                        output_name="$output_device_fallback"
                        output_id="$(awk -v output_device_fallback="$output_device_fallback" '$2 == output_device_fallback {print $1} <<< "$wpctl_list"')"
                    else
                        printf '%b%s%b fallback device not found\n' "$RED" "$output_device_fallback" "$RESET"
                        return 1
                    fi
                fi
            fi
        fi


        if [[ "${system_transfer:-}" == true ]]; then
            output_volume="$(awk -v input_gain="$global_input_gain" -v raw_volume="$raw_volume" 'BEGIN {printf "%.2f\n", (10 ^ ((input_gain + raw_volume) / 60))}')"
            wpctl set-volume "$last_output_id" "$output_volume"
            wpctl set-mute "$last_output_id" "$mute_state"
        fi

        read -r _ output_volume _ < <(wpctl get-volume "$output_id")

        if [[ "${system_transfer:-}" == true ]]; then
            if wpctl get-volume "$output_id" | grep --quiet '[MUTED]'; then
                mute_state=1
            else
                mute_state=0
            fi
        fi

        last_output_device="$output_name"
        last_output_id="$output_id"
        sanitized_name="${output_name//[-.]/_}"
        custom_input_gain="${sanitized_name}_input_gain"

        wpctl set-default "$loudcomp_node_id"
        wpctl set-volume "$loudcomp_node_id" 1.0
        wpctl set-volume "$output_id" 1.0
        sleep 0.05s

        wpctl set-mute "$output_id" "$mute_state"
    fi


    if [[ -v "$custom_input_gain" ]]; then
        global_input_gain="${!custom_input_gain}"
        is_custom_input_gain=true
    else
        is_custom_input_gain=false
    fi

    global_input_gain="$((global_input_gain+listening_volume-83))"
    raw_input_gain="$(awk -v input_gain="$global_input_gain" 'BEGIN {printf "%.6f\n", (10 ^ (input_gain / 20))}')"


    pw-cli set-param "$loudcomp_node_id" 2 "{ \"params\": [ \"loudcomp:input\", $raw_input_gain, \"loudcomp:mode\", $processing_mode, \"loudcomp:fft\", $fft_quality, \"loudcomp:approx\", $iir_approx, \"loudcomp:std\", $curve, \"loudcomp:hclip\", $is_clipping, \"loudcomp:hcrange\", $clipping_range, \"loudcomp:volume\", $raw_volume ] }" >/dev/null
    { _send_state; _save_state; } &
}


function _reload() {
    _disconnect_nodes
    _reload_config
    _connect_nodes
}


function _switch() {
    if [[ "$1" =~ ^[0-9]+$ ]]; then
        switch_device="$(wpctl list | awk -v output_id="$1" '$1 == output_id {print $2}')"
    else
        switch_device="$1"
    fi
    is_switch=true
    _reload
}


function _auto_reload() {
    coproc auto_reload {
        while read -r _ _ filename; do
            if [[ "$filename" == "settings.env" ]]; then
                printf '_reload\n' > "$runtime_dir/command_handler"
            fi
        done < <(inotifywait -q -m -e close_write "$config_dir")
    }
}


function _auto_switch() {
    coproc auto_switch {
        while read -r id; do
            if [[ -n "$id" ]]; then
                printf '_switch %d\n' "$id" > "$runtime_dir/command_handler"
            fi
        done < <(stdbuf -oL wpexec "$data_dir/get_new_device_id.lua")
    }
}


function _clean_up() {
    trap '' INT TERM
    trap - EXIT

    [[ -n "${output_id:-}" ]] && wpctl set-mute "$output_id" 1; sleep 0.1s


    (: >&3) 2>/dev/null && exec 3>&-

    _kill_with_children "${pipewire_PID:-}"
    _kill_with_children "${auto_reload_PID:-}"
    _kill_with_children "${auto_switch_PID:-}"
    _kill_with_children "${socket_PID:-}"

    if [[ -n "${output_id:-}" ]]; then
        if [[ "${system_transfer:-}" == true ]]; then
            output_volume="$(awk -v input_gain="$global_input_gain" -v raw_volume="$raw_volume" 'BEGIN {printf "%.2f\n", (10 ^ ((input_gain + raw_volume) / 60))}')"
            wpctl set-volume "$output_id" "$output_volume"
            wpctl set-mute "$output_id" "$mute_state"
        fi

        wpctl set-default "$output_id"
    fi

    _disconnect_nodes


    [[ -d "$runtime_dir" ]] && rm "$runtime_dir"/!(state.sock) 2>/dev/null || :
}


function _start_daemon() {
    trap '_clean_up; exit 0' EXIT
    trap '_clean_up; exit 130' INT
    trap '_clean_up; exit 143' TERM
    trap 'printf "Pipewire exited\n"; _clean_up; exit 1' USR1

    if [[ -f "$config_dir/settings.env" ]]; then
        source "$config_dir/settings.env"
    else
        printf 'Config not found\n' >&2
        printf 'Did you try running %c%b%s create-config%b%c?\n' >&2 "'" "$RED" "$name" "$RESET" "'"
        return 1
    fi

    [[ ! -d "$data_dir"    ]] && mkdir -p "$data_dir"

    if [[ "${runtime_dir%/user*}" == "/tmp" ]]; then
        if [[ ! -d "${runtime_dir%/*}" ]]; then
            mkdir -m 700 "${runtime_dir%/*}" || :
            mkdir -m 700 "$runtime_dir" || :
        else
            mkdir -p -m 700 "$runtime_dir" || :
        fi
    else
        [[ ! -d "$runtime_dir" ]] && mkdir -p "$runtime_dir"
    fi

    [[ ! -f "$config_dir/settings.env"        ]] && _create_config "$config_dir/settings.env"
    [[ ! -f "$data_dir/state.env"             ]] && _create_state_file "$data_dir/state.env"
    [[ ! -f "$data_dir/node_ready.lua"        ]] && _create_node_ready_script "$data_dir/node_ready.lua" "$loudcomp_node_description"
    [[ ! -f "$data_dir/get_new_device_id.lua" ]] && _create_device_watcher_script "$data_dir/get_new_device_id.lua" "$loudcomp_node_description"
    [[ ! -f "$data_dir/loudcomp_node.conf"    ]] && _create_loudcomp_node_config "$data_dir/loudcomp_node.conf" "$loudcomp_node_description"


    [[ -d "$runtime_dir" ]] && rm "$runtime_dir"/!(state.sock) 2>/dev/null || :
    printf '%d\n' "$main_pid" > "$runtime_dir/pw-loudcomp.lock"

    mkfifo "$runtime_dir/command_handler"
    exec 3<> "$runtime_dir/command_handler"

    source "$config_dir/settings.env"
    source "$data_dir/state.env"

    coproc pipewire {
        pipewire -c "$data_dir/loudcomp_node.conf" || { printf 'Pipewire failed\n' >&2; kill -USR1 "$main_pid"; }
    }

    sleep 0.1s

    if [[ "$output_device" == "auto" ]]; then
        _get_output_info
    else
        if grep --quiet "$output_device" <<< "$wpctl_list"; then
            output_name="$output_device"
            output_id="$(awk -v output_device="$output_device" '$2 == output_device {print $1}' <<< "$wpctl_list")"
        else
            if [[ "$output_device_fallback" == "none" ]]; then
                printf '%b%s%b device not found\n' "$RED" "$output_device" "$RESET"
                return 1
            elif [[ "$output_device_fallback" == "auto" ]]; then
                _get_output_info
            else
                if grep --quiet "$output_device_fallback" <<< "$wpctl_list"; then
                    output_name="$output_device_fallback"
                    output_id="$(awk -v output_device_fallback="$output_device_fallback" '$2 == output_device_fallback {print $1}' <<< "$wpctl_list")"
                else
                    printf '%b%s%b fallback device not found\n' "$RED" "$output_device_fallback" "$RESET"
                    return 1
                fi
            fi
        fi
    fi


    last_output_device="$output_name"
    last_output_id="$output_id"
    sanitized_name="${output_name//[-.]/_}"
    custom_input_gain="${sanitized_name}_input_gain"

    if [[ -v "$custom_input_gain" ]]; then
        global_input_gain="${!custom_input_gain}"
        is_custom_input_gain=true
    else
        is_custom_input_gain=false
    fi

    global_input_gain="$((global_input_gain+listening_volume-83))"
    raw_input_gain="$(awk -v input_gain="$global_input_gain" 'BEGIN {printf "%.6f\n", (10 ^ (input_gain / 20))}')"


    read -r _ output_volume _ < <(wpctl get-volume "$output_id")
    _save_state &


    if [[ "${system_transfer:-}" == true ]]; then
        if wpctl get-volume "$output_id" | grep --quiet '[MUTED]'; then
            mute_state=1
        else
            mute_state=0
        fi
    fi


    wpctl set-mute "$output_id" 1
    sleep 0.1s


    if [[ "${system_transfer:-}" == true ]]; then
        raw_volume="$(awk -v output_volume="$output_volume" -v input_gain="$global_input_gain" 'BEGIN {printf "%.0f\n", ((60 * ( log(output_volume) / log(10))) - input_gain)}')"
    else
        printf -v raw_volume '%.0f' "$raw_volume"
    fi

    [[ "$raw_volume" == "-inf" ]] && raw_volume=-83


    volume="$(awk -v raw_volume="$raw_volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.0f", 100 * (10 ^ (raw_volume / (20 * vce)))}' )"

    if [[ -z "${highest_volume_limit:-}" || "${highest_volume_limit:-}" -gt 100 ]]; then
        highest_volume_limit=100
    elif [[ -z "${lowest_volume_limit:-}" || "${lowest_volume_limit:-}" -lt 0 ]]; then
        lowest_volume_limit=0
    fi

    if [[ "$volume" -gt "$highest_volume_limit" ]]; then
        volume="$highest_volume_limit"
        raw_volume="$(awk -v volume="$volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.6f\n", 20 * log((volume / 100) ^ vce) / log(10)}')"
    elif [[ "$volume" -lt "$lowest_volume_limit"  ]]; then
        volume="$lowest_volume_limit"
        raw_volume="$(awk -v volume="$volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.6f\n", 20 * log((volume / 100) ^ vce) / log(10)}')"
    fi


    loudcomp_node_id="$(pw-dump | jq -r '.[] | select(.type=="PipeWire:Interface:Node") | select(.info.props["node.name"]=="effect_input.loudcomp") | .id')"


    _connect_nodes


    pw-cli set-param "$loudcomp_node_id" 2 "{ \"params\": [ \"loudcomp:input\", $raw_input_gain, \"loudcomp:mode\", $processing_mode, \"loudcomp:fft\", $fft_quality, \"loudcomp:approx\", $iir_approx, \"loudcomp:std\", $curve, \"loudcomp:hclip\", $is_clipping, \"loudcomp:hcrange\", $clipping_range, \"loudcomp:volume\", $raw_volume ] }" >/dev/null


    wpctl set-default "$loudcomp_node_id"
    wpctl set-volume "$loudcomp_node_id" 1.0
    wpctl set-volume "$output_id" 1.0
    sleep 0.05s

    wpctl set-mute "$output_id" "$mute_state"


    [[ "${auto_reload:-}" == true ]] && _auto_reload
    [[ "${auto_switch:-}" == true ]] && _auto_switch


    systemd-notify --ready 2>/dev/null || :

    while read -r cmd arg1 arg2; do
        case "$cmd" in
            "set")
                pw-cli set-param "$loudcomp_node_id" 2 "{ \"params\": [ \"loudcomp:$arg1\", $arg2 ] }" >/dev/null
            ;;
            "_set_relative_input_gain"|"_set_relative_volume"|"_set_input_gain"|"_set_volume"|"_set_mute_state"|"_set_curve_state"|"_stop_daemon"|"_start_socket"|"_stop_socket"|"_send_state"|"_reload"|"_switch")
                ${cmd} "$arg1" "$arg2"
            ;;
            *)
                printf '%s is not a command\n' "$cmd"
            ;;
        esac
    done <&3
}


function _stop_daemon() {
    exit 0
}


function _main() {
    builtins=("rm" "id" "mkdir" "mkfifo" "sleep")

    for builtin in "${builtins[@]}";do
        enable "$builtin" 2>/dev/null || { command -v "$builtin" >/dev/null && printf '%bWarning%b: Failed to load %c%b%s%b%c builtin, fallback to %c%b%s%b%c binary\n' "$YELLOW" "$RESET" "'" "$GRAY" "$builtin" "$RESET" "'" "'" "$MAGENTA" "$builtin" "$RESET" "'"; }
    done


    [[ -z "${USER:-}" ]] && USER="$(id -run 2>/dev/null)"
    [[ -z "${HOME:-}" ]] && IFS=':' read -r _ _ _ _ _ HOME _ < <(getent passwd "$USER")
    [[ -z "${HOME:-}" ]] && { printf 'Unable to obtained variable %sHOME%s\n' "$CYAN" "$RESET" >&2; return 1; }


    name="${0##*/}"
    main_pid="$$"
    nl=$'\n'

    config_dir="${XDG_CONFIG_HOME:-"$HOME/.config"}/$name"
    data_dir="${XDG_DATA_HOME:-"$HOME/.local/share"}/$name"

    if [[ -d "/run/user/$UID" ]]; then
        runtime_dir="${XDG_RUNTIME_DIR:-"/run/user/$UID"}/$name"
    else
        printf 'Runtime directory %b%s%b %bnot found%b, fallback to %b%s%b\n' "$BLUE" "/run/user/$UID" "$RESET" "$RED" "$RESET" "$GRAY" "/tmp/user-$UID" "$RESET"
        runtime_dir="${XDG_RUNTIME_DIR:-"/tmp/user-$UID"}/$name"
    fi

    loudcomp_node_description="LSP Loudness Compensator"
    loudcomp_node_name="${loudcomp_node_description// /-}"
    loudcomp_node_name="${loudcomp_node_name,,}"



    if [[ -z "${PIPEWIRE_RUNTIME_DIR:-}" ]] && [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
        printf 'Please make sure that %bXDG_RUNTIME_DIR%b or %bPIPEWIRE_RUNTIME_DIR%b are set when starting the daemon\n' "$MAGENTA" "$RESET" "$MAGENTA" "$RESET" >&2
        return 1
    fi

    pw-cli info 0 &>/dev/null || :

    if [[ "$?" -ne 0 ]]; then
        printf 'Operation failed\n' >&2
        printf 'Is Pipewire running?\n' >&2
        return 1
    fi


    case "${1:-}" in
        "--help"|"-h")
            _help
            return 0
        ;;
        "start-daemon")
            if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                printf 'Operation failed\n' >&2
                printf 'Daemon is already running\n' >&2
                return 1
            else
                _start_daemon
                return "$?"
            fi
        ;;
        "stop-daemon")
            if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                if systemctl --user is-active pw-loudcompd >/dev/null; then
                    systemctl --user stop pw-loudcompd
                else
                    coproc inotifywait { inotifywait -q -m -e delete "$runtime_dir"; }

                    printf '_stop_daemon\n' > "$runtime_dir/command_handler"

                    while read -r _ _ filename; do
                        if [[ "$filename" == "pw-loudcomp.lock" ]]; then
                            break
                        fi
                    done <&"${inotifywait[0]}"

                    kill "${inotifywait_PID:-}" 2>/dev/null || :
                    systemd-notify --stopping 2>/dev/null || :
                fi

                return 0
            else
                printf 'Operation failed\n' >&2
                printf 'Is the daemon running?\n' >&2
                return 1
            fi
        ;;
        "start-socket")
            if [[ ! -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                printf 'Operation failed\n' >&2
                printf 'Is the daemon running?\n' >&2
                return 1
            elif [[ -S "$runtime_dir/state.sock" ]]; then
                printf 'Operation failed\n' >&2
                printf 'Socket is already socket running\n' >&2
                return 1
            else
                printf '_start_socket\n' > "$runtime_dir/command_handler"
                return 0
            fi
        ;;
        "_socket_handler")
            _socket_handler
        ;;
        "stop-socket")
            if [[ -f "$runtime_dir/socket_pid" ]]; then
                printf '_stop_socket\n' > "$runtime_dir/command_handler"
                return 0
            else
                printf 'Operation failed\n' >&2
                printf 'Is the socket running?\n' >&2
                return 1
            fi
        ;;
        "reload")
            if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                printf '_reload\n' > "$runtime_dir/command_handler"
                return 0
            else
                printf 'Operation failed\n' >&2
                printf 'Is the daemon running?\n' >&2
                return 1
            fi
        ;;
        "set-input-gain")
            if [[ -z "${2:-}" ]]; then
                printf 'You have to specify a value\n' >&2
                _try_message
                return 1
            elif [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                if [[ "$2" =~ ^([0-9]+)%([+-])$ ]]; then
                    printf '_set_relative_input_gain %s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" > "$runtime_dir/command_handler"
                elif [[ "$2" =~ ^(-?[0-9]+)$ ]]; then
                    printf '_set_input_gain %s\n' "$2" > "$runtime_dir/command_handler"
                else
                    printf 'Invalid format: %c%b%s%b%c\n' "'" "$RED" "$2" "$RESET" "'" >&2
                    _try_message
                    return 1
                fi
            else
                printf 'Operation failed\n' >&2
                printf 'Is the daemon running?\n' >&2
                return 1
            fi
        ;;
        "set-volume")
            [[ -f "$config_dir/settings.env" ]] && source "$config_dir/settings.env"
            if [[ -z "${2:-}" ]]; then
                printf 'You have to specify a value\n' >&2
                _try_message
                return 1
            elif [[ "$2" =~ ^([0-9]+)%([+-])$ ]]; then
                if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                    printf "_set_relative_volume %s %s\n" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" > "$runtime_dir/command_handler"
                elif [[ "${system_fallback:-}" == true ]]; then
                    wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ "$2"
                else
                    printf 'Operation failed\n' >&2
                    printf 'Is the daemon running?\n' >&2
                    return 1
                fi
            elif [[ "$2" =~ ^([0-9]+)$ ]]; then
                if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                    printf "_set_volume %s\n" "$2" > "$runtime_dir/command_handler"
                elif [[ "${system_fallback:-}" == true ]]; then
                    wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ "$2"
                else
                    printf 'Operation failed\n' >&2
                    printf 'Is the daemon running?\n' >&2
                    return 1
                fi
            else
                printf 'Invalid format: %c%b%s%b%c\n' "'" "$RED" "$2" "$RESET" "'" >&2
                _try_message
                return 1
            fi
        ;;
        "set-mute-state")
            [[ -f "$config_dir/settings.env" ]] && source "$config_dir/settings.env"
            if [[ -f "$runtime_dir/pw-loudcomp.lock" ]] || [[ "${system_fallback:-}" == true ]]; then
                if [[ -z "${2:-}" ]]; then
                    printf 'You have to specify a value\n' >&2
                    return 1
                elif [[ ! "$2" =~ ^(1|0|toggle)$ ]]; then
                    printf 'Invalid format: %c%b%s%b%c\n' "'" "$RED" "$2" "$RESET" "'" >&2
                    _try_message
                    return 1
                elif [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                    printf '_set_mute_state %s\n' "$2" > "$runtime_dir/command_handler"
                    return 0
                else
                    wpctl set-mute @DEFAULT_AUDIO_SINK@ "$2"
                    return 0
                fi
            else
                printf 'Operation failed\n' >&2
                printf 'Is the daemon running?\n' >&2
                return 1
            fi
        ;;
        "set-curve-state")
            if [[ -z "${2:-}" ]]; then
                printf 'You have to specify a value\n' >&2
                return 1
            elif [[ "$2" =~ ^(1|0|toggle)$ ]]; then
                if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                    printf '_set_curve_state %s\n' "$2" > "$runtime_dir/command_handler"
                    return 0
                else
                    printf 'Operation failed\n' >&2
                    printf 'Is the daemon running?\n' >&2
                    return 1
                fi
            else
                printf 'Invalid format: %c%b%s%b%c\n' "'" "$RED" "$2" "$RESET" "'" >&2
                _try_message
                return 1
            fi
        ;;
        "set")
            if [[ -z "${3:-}" ]]; then
                printf 'You have to specify two values\n' >&2
                _try_message
                return 1
            else
                if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                    printf 'set %s %s\n' "$2" "$3" > "$runtime_dir/command_handler"
                else
                    printf 'Operation failed\n' >&2
                    printf 'Is the daemon running?\n' >&2
                    return 1
                fi
            fi
        ;;
        "create-config")
            _check_config
            return "$?"
        ;;
        "")
            printf 'You have to specify a command\n' >&2
            _try_message
            return 1
        ;;
        *)
            printf 'Unknown command: %c%b%s%b%c\n' "'" "$RED" "$1" "$RESET" "'" >&2
            _try_message
            return 1
        ;;
    esac
}


_main "$@"
exit "$?"
