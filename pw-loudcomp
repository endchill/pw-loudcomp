function _update_output_info_auto() {
    local wpctl_devices_list="$1"

    read -r output_name output_id < <(awk '/audio\/sink.*\*/ { printf "%s\t%d\n", $2, $1 }' <<< "$wpctl_devices_list") || :

    if [[ -z "$output_name" || -z "$output_id" ]]; then
        IFS=$'\t' read -r output_name output_id < <(while read -r id; do wpctl inspect "$id"; done < <(awk '/sink/ {print $1}' <<< "$wpctl_devices_list") | awk -F '[ ,]' '
            /^id/ {id = $2; FS = "= "; $0 = $0}
            /node\.name/ {gsub(/^"+|"+$/, "", $2); name = $2 "\t" id}
            /priority.session/ { gsub(/^"+|"+$/, "", $2); list[$2] = name; FS = "[ ,]"; $0 = $0}
            END {PROCINFO["sorted_in"] = "@ind_num_desc"; for (score in list) {print list[score]; break}; }
        ')
    fi
}


function _update_output_info() {
    wpctl_list="$(wpctl list)"

    if [[ "$output_device" == "auto" ]]; then
        _update_output_info_auto "$wpctl_list"
    else
        if [[ "$wpctl_list" == *"$output_device"* ]]; then
            output_name="$output_device"
            output_id="$(awk -v output_device="$output_device" '$2 == output_device {print $1}' <<< "$wpctl_list")"
        else
            if [[ "$output_device_fallback" == "none" ]]; then
                _print_message "stderr" "No such device" "cannot find '${RED}${output_device}${RESET}'"
                return 1
            elif [[ "$output_device_fallback" == "auto" ]]; then
                _update_output_info_auto "$wpctl_list"
            else
                if [[ "$wpctl_list" == *"$output_device_fallback"* ]]; then
                    output_name="$output_device_fallback"
                    output_id="$(awk -v output_device_fallback="$output_device_fallback" '$2 == output_device_fallback {print $1}' <<< "$wpctl_list")"
                else
                    _print_message "stderr" "No such device" "cannot find fallback '${RED}${output_device_fallback}${RESET}'"
                    return 1
                fi
            fi
        fi
    fi
}


function _save_state() {
    printf 'output_volume=%.2f\nmute_state=%d\ncurve_state=%d\nraw_input_gain=%.6f\nraw_volume=%.6f\n' "$output_volume" "$mute_state" "$curve_state" "$raw_input_gain" "$raw_volume" > "$data_dir/state.env"
}


# shellcheck disable=SC2329
function _send_state() {
    for fifo_filepath in "$runtime_dir"/*; do
        [[ -p "$fifo_filepath" && "$fifo_filepath" != "$runtime_dir/command_handler" ]] || continue

        printf '{"outputID": %d, "inputGain": %d, "volume": %d, "muteState": %d, "curveState": %d, "listeningVolume": %d, "highestInputGainLimit": %d, "lowestInputGainLimit": %d, "highestVolumeLimit": %d, "lowestVolumeLimit": %d}\n' "$output_id" "$global_input_gain" "$volume" "$mute_state" "$curve_state" "$listening_volume" "${highest_input_gain_limit:-$global_input_gain}" "${lowest_input_gain_limit:-$global_input_gain}" "${highest_volume_limit:-100}" "${lowest_volume_limit:-0}" > "$fifo_filepath" &
    done

    if [[ "${XDG_CURRENT_DESKTOP:-}" == "KDE" ]]; then
        if [[ "$mute_state" == 0 ]]; then
            qdbus6 org.kde.plasmashell /org/kde/osdService org.kde.osdService.volumeChanged "$volume" 2>/dev/null &
        else
            qdbus6 org.kde.plasmashell /org/kde/osdService org.kde.osdService.volumeChanged 0 2>/dev/null &
        fi
    fi

    if [[ "$play_sound" == true ]] && [[ "$mute_state" == 0 ]] && [[ "${sound_available:-}" == true ]]; then
        play "/usr/share/sounds/$sound_theme/stereo/audio-volume-change.oga" 2>/dev/null &
    fi
}


# shellcheck disable=SC2329
function _set_input_gain() {
    local previous_input_gain
    local new_volume
    local auto_adjust_trigger
    previous_input_gain="$global_input_gain"

    if [[ -n "${highest_input_gain_limit:-}" && "$1" -ge "$highest_input_gain_limit" ]]; then
        global_input_gain="$highest_input_gain_limit"
    elif [[ -n "${lowest_input_gain_limit:-}" && "$1" -le "$lowest_input_gain_limit" ]]; then
        global_input_gain="$lowest_input_gain_limit"
    else
        global_input_gain="$1"
    fi

    raw_input_gain="$(awk -v input_gain="$global_input_gain" 'BEGIN {printf "%.6f\n", (10 ^ (input_gain / 20))}')"


    if [[ "${auto_adjust_volume:-}" == true ]]; then
        auto_adjust_trigger=true
        new_volume="$(awk -v volume="$volume" -v db_diff="$((previous_input_gain-global_input_gain))" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.0f\n", volume * (10 ^ (db_diff / (20 * vce)))}')"

        wpctl set-mute "$output_id" 1
        sleep 0.1s
        _set_volume "$new_volume"
    fi


    _pwcli_set_param 2 "{ \"params\": [ \"loudcomp:input\", $raw_input_gain ] }"
    [[ "${auto_adjust_trigger:-}" == true ]] && wpctl set-mute "$output_id" 0
    { _send_state; _save_state; } &

    if [[ "$is_custom_input_gain" == true ]]; then
        key="$custom_input_gain"
    else
        key="global_input_gain"
    fi

    settings_filepath_tmp=""
    while IFS= read -r line || [[ -n "$line" ]]; do
        if [[ "$line" == "${key}="* ]]; then
            rest="${line#"${key}="}"
            value="${rest%%[[:space:]]*}"
            line="${key}=${global_input_gain}${rest#"$value"}"
        fi
        settings_filepath_tmp+="$line"$'\n'
    done < "$config_dir/settings.env"

    printf '%s' "$settings_filepath_tmp" > "$config_dir/settings.env.tmp"
    mv "$config_dir/settings.env.tmp" "$config_dir/settings.env"
}


# shellcheck disable=SC2329
function _set_volume() {
    if [[ "$1" -gt "$highest_volume_limit" ]]; then
        volume="$highest_volume_limit"
    elif [[ "$1" -lt "$lowest_volume_limit" ]]; then
        volume="$lowest_volume_limit"
    else
        volume="$1"
    fi

    [[ "$volume" -eq "${previous_volume:-}" ]] && return

    previous_volume="$volume"

    if [[ "$mute_state" -eq 1 ]]; then
        wpctl set-mute "$output_id" 0
        mute_state=0
    fi

    raw_volume="$(awk -v volume="$volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.6f\n", 20 * log((volume / 100) ^ vce) / log(10)}')"
    [[ "$raw_volume" == "-inf"  ]] && raw_volume=-83

    _pwcli_set_param 2 "{ \"params\": [ \"loudcomp:volume\", $raw_volume ] }"
    { _send_state; _save_state; } &
}


# shellcheck disable=SC2329
function _set_relative_input_gain() {
    local absolute_input_gain
    if [[ "$2" == "+" ]]; then
        absolute_input_gain="$((global_input_gain+$1))"
    else
        absolute_input_gain="$((global_input_gain-$1))"
    fi

    _set_input_gain "$absolute_input_gain"
}


# shellcheck disable=SC2329
function _set_relative_volume() {
    if [[ "$2" == "+" ]]; then
        volume="$((volume+$1))"
    else
        volume="$((volume-$1))"
    fi

    _set_volume "$volume"
}


# shellcheck disable=SC2329
function _set_mute_state() {
    local value="$1"

    if [[ "$value" == "toggle" ]]; then
        if [[ "$mute_state" -eq 1 ]]; then
            value=0
        else
            value=1
        fi
    fi

    mute_state="$value"

    wpctl set-mute "$output_id" "$mute_state"
    { _send_state; _save_state; } &
}


# shellcheck disable=SC2329
function _set_curve_state() {
    if [[ "$1" == "toggle" ]]; then
        if [[ "$curve_state" -eq "$curve" ]]; then
            curve_state=0
        else
            curve_state="$curve"
        fi
    elif [[ "$1" -eq 1 ]]; then
        curve_state="$curve"
    else
        curve_state=0
    fi


    _pwcli_set_param 2 "{ \"params\": [ \"loudcomp:std\", $curve_state ] }"
    { _send_state; _save_state; } &
}


# shellcheck disable=SC2329
function _start_socket() {
    trap '_stop_socket' EXIT
    trap '_stop_socket; exit 130' INT
    trap '_stop_socket; exit 143' TERM

    # shellcheck disable=SC2174
    [[ ! -d "$runtime_dir" ]] && mkdir -p -m 700 "$runtime_dir"

    # shellcheck disable=SC2034
    coproc socket {
        exec socat UNIX-LISTEN:"$runtime_dir/state.sock",fork EXEC:"$0 _socket_handler"
    }

    # shellcheck disable=SC2154
    printf '%s\n' "$socket_PID" > "$runtime_dir/socket_pid"

    _print_log "info" "socket is running"

    wait "$socket_PID"
}


function _socket_handler() {
    trap '' INT TERM
    trap - EXIT

    fifo_filepath="$runtime_dir/$$"
    mkfifo "$fifo_filepath"
    trap 'rm "$fifo_filepath"' EXIT
    exec 3<> "$fifo_filepath"

    sleep 0.01s && printf '_send_state\n' > "$runtime_dir/command_handler"
    while read -r line; do
        printf '%s\n' "$line"
    done <&3

    (: >&3) 2>/dev/null && exec 3>&-
}


# shellcheck disable=SC2329
function _stop_socket() {
    if [[ -e "$runtime_dir/socket_pid" ]]; then
        _kill_recursively "$(<"$runtime_dir/socket_pid")"

        for pipe_filename in "$runtime_dir"/*;do
            if [[ -p "$pipe_filename" ]] && [[ "$pipe_filename" != "$runtime_dir/command_handler" ]]; then
                rm "$pipe_filename"
            fi
        done

        rm "$runtime_dir/socket_pid"
    fi
}


