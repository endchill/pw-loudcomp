function _try_message() {
    printf 'Try %c%b%s --help%b%c for more information\n' "'" "$RED" "$name" "$RESET" "'" >&2
}


function _kill_with_children() {
    local parent_pid="$1"
    local children_pids=()
    local child_pid

    if [[ -n "${parent_pid:-}" ]] && kill -0 "$parent_pid" 2>/dev/null; then
        read -r -a children_pids < "/proc/$parent_pid/task/$parent_pid/children" || :

        for child_pid in "${children_pids[@]}"; do
            _kill_with_children "$child_pid"
        done

        kill "$parent_pid" 2>/dev/null || :
    fi
}


function _check_config() {
    trap "printf '\nOperation cancelled\n'; return 0" INT TERM

    if [[ -f "$config_dir/settings.env" ]]; then
        printf 'Found config at %c%b%s%b%c\n' "'" "$BOLD" "$config_dir/settings.env" "$RESET" "'"
        printf 'Do you want to overwrite it? [%by%b/%bN%b] ' "$GREEN" "$RESET" "$RED" "$RESET"
        read -r awnser
        if [[ "$awnser" =~ ^[Yy]$ ]]; then
            _create_config "$config_dir/settings.env"
            printf 'Config created at %c%b%s%b%c\n' "'" "$GREEN" "$config_dir/settings.env" "$RESET" "'"
            printf 'Please edit the config to have the most accurate results\n'
        else
            printf 'Operation cancelled\n'
            return 0
        fi
    else
        printf 'Do you want to create a config? [%bY%b/%bn%b] ' "$GREEN" "$RESET" "$RED" "$RESET"
        read -r awnser
        if [[ ! "$awnser" =~ ^[Nn]$ ]]; then
            _create_config "$config_dir/settings.env"
            printf 'Config created at %c%b%s%b%c\n' "'" "$GREEN" "$config_dir/settings.env" "$RESET" "'"
            printf 'Please edit the config to have the most accurate results\n'
        else
            printf 'Operation cancelled\n'
            return 0
        fi
    fi
}


