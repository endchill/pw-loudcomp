# connects loudcomp node to device node
function _connect_nodes() {
    local line pid is_connected

    exec 4< <(stdbuf -oL wpexec "$data_dirpath/node_ready.lua")
    pid="$!"


    while read -r -u 4 -t 10 line; do
        if [[ "$line" == "ready" ]]; then
            sleep 0.1s
            pw-link -P "${loudcomp_node_description}:output_FL" "${output_name}:playback_FL" 2>/dev/null || :
            pw-link -P "${loudcomp_node_description}:output_FR" "${output_name}:playback_FR" 2>/dev/null || :
            is_connected=true
            break
        fi
    done

    (: >&4) 2>/dev/null && exec 4>&-
    _kill_recursively "$pid" || :

    [[ "${is_connected:-}" == true ]] || _print_log "warn" "timed out waiting for the loudcomp node"
}


