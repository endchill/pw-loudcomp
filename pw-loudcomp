function _print_message() {
    local file_descriptor stream_type what_failed reason
    stream_type="$1"
    reason="$2"
    what_failed="${3:-}"

    if [[ "$stream_type" == "stdout" ]]; then
        file_descriptor=1
    elif [[ "$stream_type" == "stderr" ]]; then
        file_descriptor=2
    fi

    if [[ -n "${what_failed:-}" ]]; then
        printf '%b%s%b: %s: %s\n' "$BOLD" "$name" "$RESET" "$what_failed" "$reason" >& "$file_descriptor"
    else
        printf '%b%s%b: %s\n' "$BOLD" "$name" "$RESET" "$reason" >& "$file_descriptor"
    fi
}


function _print_log() {
    local file_descriptor log_level_color stream_type message
    log_level="$1"
    message="$2"

    case "$log_level" in
        "info")
            log_level_color="$BLUE"
            file_descriptor=1
        ;;
        "warn")
            log_level_color="$YELLOW"
            file_descriptor=2
        ;;
        "error")
            log_level_color="$RED"
            file_descriptor=2
        ;;
    esac

    printf '[%b%s%b] %s\n' "$log_level_color" "$log_level" "$RESET" "$message" >& "$file_descriptor"
}


# shellcheck disable=SC2329
function _kill_recursively() {
    local parent_pid="$1"
    local children_pids=()
    local child_pid

    if [[ -n "${parent_pid:-}" ]] && kill -0 "$parent_pid" 2>/dev/null; then
        read -r -a children_pids < "/proc/$parent_pid/task/$parent_pid/children" || :

        for child_pid in "${children_pids[@]}"; do
            _kill_recursively "$child_pid"
        done

        kill "$parent_pid" 2>/dev/null || :
    fi
}


function _check_config() {
    trap "printf '\nOperation cancelled\n'; exit 130" INT TERM

    if [[ -f "$config_dir/settings.env" ]]; then
        printf 'Found config at %c%b%s%b%c\n' "'" "$BOLD" "$config_dir/settings.env" "$RESET" "'"
        printf 'Do you want to overwrite it? [%by%b/%bN%b] ' "$GREEN" "$RESET" "$RED" "$RESET"
        read -r answer
        if [[ "$answer" =~ ^[Yy]$ ]]; then
            _create_config "$config_dir/settings.env"
            printf 'Config created at %c%b%s%b%c\n' "'" "$GREEN" "$config_dir/settings.env" "$RESET" "'"
            printf 'Please edit the config to have the most accurate results\n'
        else
            printf 'OK!\n'
            return 0
        fi
    else
        printf 'Do you want to create a config? [%bY%b/%bn%b] ' "$GREEN" "$RESET" "$RED" "$RESET"
        read -r answer
        if [[ ! "$answer" =~ ^[Nn]$ ]]; then
            _create_config "$config_dir/settings.env"
            printf 'Config created at %c%b%s%b%c\n' "'" "$GREEN" "$config_dir/settings.env" "$RESET" "'"
            printf 'Please edit the config to have the most accurate results\n'
        else
            printf 'OK!\n'
            return 0
        fi
    fi
}


