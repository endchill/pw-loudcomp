                ;;
                *)
                    _print_message "stderr" "" #TODO missing message
                    printf '\n'
                    _help "stderr"
                    return 2
                ;;
            esac
        done
    fi


    case "${operation:-}" in
        "start-daemon")
            if [[ -f "$runtime_dirpath/$name.lock" ]]; then
                if [[ "${is_systemd_used:-}" == true ]] && systemctl --user is-active pw-loudcompd.service >/dev/null; then
                    _print_message "stderr" "Daemon already running via systemd service" "cannot start daemon"
                else
                    _print_message "stderr" "Daemon already running" "cannot start daemon"
                fi

                return 1
            else
                _start_daemon
                return "$?"
            fi
        ;;
        "stop-daemon")
            if [[ -f "$runtime_dirpath/$name.lock" ]]; then
                if [[ -t 0 ]] && [[ "${is_systemd_used:-}" == true ]] && systemctl --user is-active pw-loudcompd.service &>/dev/null; then
                    systemctl --user stop pw-loudcompd.service
                    _print_message "stdout" "daemon has been stopped via systemd socket"
                    return 0
                else
                    coproc inotifywait { exec inotifywait -q -m -e delete "$runtime_dirpath"; }

                    # shellcheck disable=SC2154
                    trap 'kill "${inotifywait_PID:-}" &>/dev/null' INT

                    printf '_stop_daemon\n' > "$runtime_dirpath/command_handler"

                    while read -r _ _ filename; do
                        if [[ "$filename" == "$name.lock" ]]; then
                            break
                        fi
                    done <&"${inotifywait[0]}"

                    kill "${inotifywait_PID:-}" &>/dev/null

                    sleep 1s

                    [[ "${is_systemd_used:-}" == true ]] && systemd-notify --stopping &>/dev/null || :
                fi

                return 0
            else
                _print_message "stderr" "No such process" "cannot access daemon"
                return 1
            fi
        ;;
        "start-socket")
            if [[ "${is_systemd_used:-}" == true ]] && systemctl --user is-active pw-loudcomp-socket.socket &>/dev/null; then
                _print_message "stderr" "Socket already running via systemd socket" "cannot start socket"
                return 1
            else
                if [[ -S "$runtime_dirpath/state.sock" ]]; then
                    _print_message "stderr" "Socket already running" "cannot start socket"
                    return 1
                else
                    _start_socket
                    return 0
                fi
            fi
        ;;
        "stop-socket")
            if [[ "${is_systemd_used:-}" == true ]]; then
                if systemctl --user is-active pw-loudcomp-socket.socket &>/dev/null; then
                    systemctl --user stop pw-loudcomp-socket.socket
                    _print_message "stdout" "socket has been stopped via systemd socket"
                    return 0
                else
                    _print_message "stderr" "No such process" "cannot stop socket"
                    return 1
                fi
            else
                if [[ -S "$runtime_dirpath/state.sock" ]]; then
                    _stop_socket
                    return 0
                else
                    _print_message "stderr" "No such process" "cannot stop socket"
                    return 1
                fi
            fi
        ;;
        "_socket_handler")
            _socket_handler
            return "$?"
        ;;
        "reload")
            if [[ -f "$runtime_dirpath/$name.lock" ]]; then
                printf '_reload\n' > "$runtime_dirpath/command_handler"
                return 0
            else
                _print_message "stderr" "No such process" "cannot access daemon"
                return 1
            fi
        ;;
        "set-input-gain")
            if [[ -f "$runtime_dirpath/$name.lock" ]]; then
                if [[ "$set_value" =~ ^([0-9]+)%([+-])$ ]]; then
                    printf '_set_relative_input_gain %s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" > "$runtime_dirpath/command_handler"
                elif [[ "$set_value" =~ ^(-?[0-9]+)$ ]]; then
                    printf '_set_input_gain %s\n' "$set_value" > "$runtime_dirpath/command_handler"
                else
                    _print_message "stderr" "Invalid argument" "'${RED}$set_value${RESET}'"
                    printf '\n'
                    _help "stderr"
                    return 2
                fi
            else
                _print_message "stderr" "No such process" "cannot access daemon"
                return 1
            fi
        ;;
        "set-volume")
            # shellcheck disable=SC1090
            if [[ -f "$config_filepath" ]] && . "$config_filepath" &>/dev/null; then
                # shellcheck disable=SC1090
                . "$config_filepath"
            else
                _print_message "stderr" "Unable to source $config_filepath"
                return 1
            fi

            _check_sound

            if [[ "$set_value" =~ ^([0-9]+)%([+-])$ ]]; then
                if [[ -f "$runtime_dirpath/$name.lock" ]]; then
                    printf "_set_relative_volume %s %s\n" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" > "$runtime_dirpath/command_handler"
                    return 0
                elif [[ "${system_fallback:-}" == true ]]; then
                    wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ "$set_value"
                    wpctl set-mute @DEFAULT_AUDIO_SINK@ 0

                    if [[ "$play_sound" == true ]] && [[ "${sound_available:-}" == true ]]; then
                        play "/usr/share/sounds/$sound_theme/stereo/audio-volume-change.oga" 2>/dev/null &
                    fi
                else
                    _print_message "stderr" "No such process" "cannot access daemon"
                    return 1
                fi
            elif [[ "$set_value" =~ ^([0-9]*)(\.?[0-9]+)$ ]]; then
                if [[ -f "$runtime_dirpath/$name.lock" ]]; then
                    printf "_set_volume %s\n" "$(awk -v volume="$set_value" 'BEGIN {printf "%.0f", volume * 100 }')" > "$runtime_dirpath/command_handler"
                    return 0
                elif [[ "${system_fallback:-}" == true ]]; then
                    wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ "$set_value"
                    wpctl set-mute @DEFAULT_AUDIO_SINK@ 0

                    if [[ "$play_sound" == true ]] && [[ "${sound_available:-}" == true ]]; then
                        play "/usr/share/sounds/$sound_theme/stereo/audio-volume-change.oga" 2>/dev/null &
                    fi
                else
                    _print_message "stderr" "No such process" "cannot access daemon"
                    return 1
                fi
            else
                _print_message "stderr" "Invalid argument" "'${RED}$set_value${RESET}'"
                printf '\n'
                _help "stderr"
                return 2
            fi
        ;;
        "set-mute")
            # shellcheck disable=SC1090
            if [[ -f "$config_filepath" ]] && . "$config_filepath" &>/dev/null; then
                # shellcheck disable=SC1090
                . "$config_filepath"
            else
                _print_message "stderr" "Unable to source $config_filepath"
                return 1
            fi

            if [[ -f "$runtime_dirpath/$name.lock" ]] || [[ "${system_fallback:-}" == true ]]; then
                if [[ ! "$set_value" =~ ^(1|0|toggle)$ ]]; then
                    _print_message "stderr" "Invalid argument" "'${RED}$set_value${RESET}'"
                    printf '\n'
                    _help "stderr"
                    return 2
                elif [[ -f "$runtime_dirpath/$name.lock" ]]; then
                    printf '_set_mute_state %s\n' "$set_value" > "$runtime_dirpath/command_handler"
                    return 0
                else
                    wpctl set-mute @DEFAULT_AUDIO_SINK@ "$set_value"
                    wpctl_get_volume="$(wpctl get-volume @DEFAULT_AUDIO_SINK@)"

                    if [[ "${XDG_CURRENT_DESKTOP:-}" == "KDE" ]]; then
                        if [[ "$wpctl_get_volume" == *"[MUTED]"* ]]; then
                            qdbus6 org.kde.plasmashell /org/kde/osdService org.kde.osdService.volumeChanged 0 &>/dev/null &
                        else
                            qdbus6 org.kde.plasmashell /org/kde/osdService org.kde.osdService.volumeChanged "$(awk -v volume="${wpctl_get_volume:8}" 'BEGIN {printf "%.0f\n", volume * 100}')" &>/dev/null &
                        fi
                    fi
                    return 0
                fi
            else
                _print_message "stderr" "No such process" "cannot access daemon"
                return 1
            fi
        ;;
        "set-curve-state")
            if [[ "$set_value" =~ ^(1|0|toggle)$ ]]; then
                if [[ -f "$runtime_dirpath/$name.lock" ]]; then
                    printf '_set_curve_state %s\n' "$set_value" > "$runtime_dirpath/command_handler"
                    return 0
                else
                    _print_message "stderr" "No such process" "cannot access daemon"
                    return 1
                fi
            else
                _print_message "stderr" "Invalid argument" "'${RED}$set_value${RESET}'"
                printf '\n'
                _help "stderr"
                return 2
            fi
        ;;
        "set")
            if [[ -f "$runtime_dirpath/$name.lock" ]]; then
                printf 'set %s %s\n' "$set_first_value" "$set_second_value" > "$runtime_dirpath/command_handler"
            else
                _print_message "stderr" "No such process" "cannot access daemon"
                return 1
            fi
        ;;
        "create-config")
            _check_config
            return "$?"
        ;;
        *)
            _print_message "stderr" "Invalid argument" "unspecified command"
            printf '\n'
            _help "stderr"
            return 2
        ;;
    esac
}


_main "$@"
exit "$?"
