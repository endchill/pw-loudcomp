# _print_message {stdout|stderr} <reason_message> [what_failed_message]
function _print_message() {
    local file_descriptor stream_type what_failed reason
    local stream_type="$1" reason="$2" what_failed="${3:-}"

    if [[ "$stream_type" == "stdout" ]]; then
        file_descriptor=1
    elif [[ "$stream_type" == "stderr" ]]; then
        file_descriptor=2
    fi

    if [[ -n "${what_failed:-}" ]]; then
        printf '%b%s%b: %s: %s\n' "$BOLD" "$name" "$RESET" "$what_failed" "$reason" >& "$file_descriptor"
    else
        printf '%b%s%b: %s\n' "$BOLD" "$name" "$RESET" "$reason" >& "$file_descriptor"
    fi
}


# _print_log {info|warn|error} <log_message>
function _print_log() {
    local file_descriptor log_level_color stream_type message
    local log_level="$1" message="$2"

    case "$log_level" in
        "info")
            log_level_color="$BLUE"
            file_descriptor=1
        ;;
        "warn")
            log_level_color="$YELLOW"
            file_descriptor=2
        ;;
        "error")
            log_level_color="$RED"
            file_descriptor=2
        ;;
        "verbose")
            log_level_color="$GREEN"
            file_descriptor=2
        ;;
    esac

    printf '[%b%s%b] %s\n' "$log_level_color" "$log_level" "$RESET" "$message" >& "$file_descriptor"
}


# declare -A variables=([variable_name]=data_type)
# declare -A defaults=([variable_name]=default_value)
# _source <filepath> variables values
# shellcheck disable=SC2329
function _source() {
    local is_valid_data_type variable
    local filepath="$1"
    local -n _variables="$2" _defaults="$3"

    # shellcheck disable=SC2016
    if /usr/bin/env bash -eu -c '. "$1"' _ "$filepath" &>/dev/null; then
        # shellcheck disable=SC1090
        . "$filepath"
        for variable in "${!_variables[@]}"; do
            is_valid_data_type=false
            value="${!variable}"
            data_type="${_variables[$variable]}"

            if [[ -n "$variable" ]]; then
                case "$data_type" in
                    "integer")
                        if [[ "$value" =~ ^(-?)([0-9]+)$ ]]; then
                            is_valid_data_type=true
                        fi
                    ;;
                    "float")
                        if [[ "$value" =~ ^(-?)([0-9]*)(\.[0-9]+)$ ]]; then
                            is_valid_data_type=true
                        fi
                    ;;
                    "integer/float")
                        if [[ "$value" =~ ^(-?)([0-9]*)(\.?[0-9]+)$ ]]; then
                            is_valid_data_type=true
                        fi
                    ;;
                    "integer/empty")
                        if [[ -z "$value" || "$value" =~ ^(-?)([0-9]+)$ ]]; then
                            is_valid_data_type=true
                        fi
                    ;;
                    "string")
                        if ! [[ -z "$value" || "$value" =~ ^(-?)([0-9]+)$ ]]; then
                            is_valid_data_type=true
                        fi
                    ;;
                esac

                if [[ "${is_valid_data_type:-}" != true ]]; then
                    _print_log "error" "$filepath: ${RED}invalid data type${RESET}, ${CYAN}${variable}${RESET} should be ${MAGENTA}$data_type${RESET}, falling back to default value ${YELLOW}'${_defaults[$variable]}'${RESET}"
                    declare -g "$variable=${_defaults[$variable]}"
                    continue
                fi
            else
                _print_log "error" "$filepath: ${RED}unset variable${RESET} ${CYAN}${variable}${RESET}, falling back to default value ${YELLOW}'${_defaults[$variable]}'${RESET}"
                declare -g "$variable=${_defaults[$variable]}"
                continue
            fi

            [[ "${verbose:-}" == true ]] && _print_log "verbose" "$filepath: ${GRAY}source${RESET} variable ${CYAN}${variable}${RESET} with value ${YELLOW}$value${RESET}"
        done
    else
        _print_log "error" "$filepath: ${RED}invalid environment file${RESET}, falling back to default values"
        for variable in "${!_variables[@]}"; do
            declare -g "$variable=${_defaults[$variable]}"
            printf '    %b%s%b %b%s%b\n' "$CYAN" "$variable" "$RED" "$YELLOW" "${_defaults[$variable]}" "$RED"
        done
    fi

    unset _variables _defaults
}


# kill a process and all children processes
# _kill_recursively <pid>
# shellcheck disable=SC2329
function _kill_recursively() {
    local child_pid children_pids=()
    local parent_pid="$1"

    if [[ -n "${parent_pid:-}" ]] && kill -0 "$parent_pid" 2>/dev/null; then
        read -r -a children_pids < "/proc/$parent_pid/task/$parent_pid/children" || :

        for child_pid in "${children_pids[@]}"; do
            _kill_recursively "$child_pid"
        done

        kill "$parent_pid" 2>/dev/null || :
    fi
}


# realpath in pure bash for only files
function _realpath() {
    local dir base
    local target="$1"

    if [[ "$target" == */* ]]; then
        dir=${target%/*}
        base=${target##*/}
    else
        dir=.
        base=$target
    fi

    (cd -P -- "${dir:-/}" && printf '%s/%s\n' "$(pwd -P)" "$base")
}


