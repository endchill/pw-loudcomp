function _connect_nodes() {
    while read -r line; do
        if [[ "$line" == "ready" ]]; then
            sleep 0.1s
            pw-link -P "${loudcomp_node_description}:output_FL" "${output_name}:playback_FL" 2>/dev/null || :
            pw-link -P "${loudcomp_node_description}:output_FR" "${output_name}:playback_FR" 2>/dev/null || :
            break
        fi
    done < <(stdbuf -oL wpexec "$data_dir/node_ready.lua")
}


# shellcheck disable=SC2329
function _disconnect_nodes() {
    pw-link -d "${loudcomp_node_description:-}:output_FL" "${output_name:-}:playback_FL" 2>/dev/null || :
    pw-link -d "${loudcomp_node_description:-}:output_FR" "${output_name:-}:playback_FR" 2>/dev/null || :
}


# shellcheck disable=SC2329
function _reload_config() {
    # shellcheck disable=SC1091
    source "$config_dir/settings.env"
    # shellcheck disable=SC1091
    source "$data_dir/state.env"

    [[ -z "${highest_volume_limit:-}" || "${highest_volume_limit:-}" -gt 100 ]] && highest_volume_limit=100
    [[ -z "${lowest_volume_limit:-}"  || "${lowest_volume_limit:-}"  -lt 0   ]] && lowest_volume_limit=0

    [[ "$volume" -gt "$highest_volume_limit" ]] && volume="$highest_volume_limit"
    [[ "$volume" -lt "$lowest_volume_limit"  ]] && volume="$lowest_volume_limit"

    raw_volume="$(awk -v volume="$volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.6f\n", 20 * log((volume / 100) ^ vce) / log(10)}')"
    [[ "$raw_volume" == "-inf" ]] && raw_volume=-83


    if [[ "$output_device" == "auto" && "${is_switch:-}" == true && "${switch_device:-}" != "$last_output_device" ]]; then
        output_device="$switch_device"
        is_switch=false
    else
        wpctl set-default "$loudcomp_node_id"
        wpctl set-volume "$loudcomp_node_id" 1.0
    fi

    if [[ "$output_device" != "$last_output_device" ]]; then
        _update_output_info

        if [[ "${system_transfer:-}" == true ]]; then
            output_volume="$(awk -v input_gain="$global_input_gain" -v raw_volume="$raw_volume" 'BEGIN {printf "%.2f\n", (10 ^ ((input_gain + raw_volume) / 60))}')"
            wpctl set-volume "$last_output_id" "$output_volume"
            wpctl set-mute "$last_output_id" "$mute_state"
        fi

        read -r _ output_volume _ < <(wpctl get-volume "$output_id")

        if [[ "${system_transfer:-}" == true ]]; then
            if [[ "$(wpctl get-volume "$output_id")" == *"[MUTED]"* ]]; then
                mute_state=1
            else
                mute_state=0
            fi
        fi

        last_output_device="$output_name"
        last_output_id="$output_id"
        sanitized_name="${output_name//[-.]/_}"
        custom_input_gain="${sanitized_name}_input_gain"

        wpctl set-default "$loudcomp_node_id"
        wpctl set-volume "$loudcomp_node_id" 1.0
        wpctl set-volume "$output_id" 1.0
        sleep 0.05s

        wpctl set-mute "$output_id" "$mute_state"
    fi


    if [[ -v "$custom_input_gain" ]]; then
        global_input_gain="${!custom_input_gain}"
        is_custom_input_gain=true
    else
        is_custom_input_gain=false
    fi

    global_input_gain="$((global_input_gain+listening_volume-83))"
    raw_input_gain="$(awk -v input_gain="$global_input_gain" 'BEGIN {printf "%.6f\n", (10 ^ (input_gain / 20))}')"


    _pwcli_set_param 2 "{ \"params\": [ \"loudcomp:input\", $raw_input_gain, \"loudcomp:mode\", $processing_mode, \"loudcomp:fft\", $fft_quality, \"loudcomp:approx\", $iir_approx, \"loudcomp:std\", $curve, \"loudcomp:hclip\", $is_clipping, \"loudcomp:hcrange\", $clipping_range, \"loudcomp:volume\", $raw_volume ] }"
    { _send_state; _save_state; } &
}


# shellcheck disable=SC2329
function _reload() {
    _disconnect_nodes
    _reload_config
    _connect_nodes
}


# shellcheck disable=SC2329
function _switch() {
    if [[ "$1" =~ ^[0-9]+$ ]]; then
        switch_device="$(wpctl list | awk -v output_id="$1" '$1 == output_id {print $2}')"
    else
        switch_device="$1"
    fi
    is_switch=true
    _reload
}


function _start_auto_reload() {
    coproc auto_reload {
        while read -r _ _ filename; do
            if [[ "$filename" == "settings.env" ]]; then
                printf '_reload\n' > "$runtime_dir/command_handler"
            fi
        done < <(inotifywait -q -m -e close_write "$config_dir")
    }
}


function _start_auto_switch() {
    coproc auto_switch {
        while read -r id; do
            if [[ -n "$id" ]]; then
                printf '_switch %d\n' "$id" > "$runtime_dir/command_handler"
            fi
        done < <(stdbuf -oL wpexec "$data_dir/get_new_device_id.lua")
    }
}


# shellcheck disable=SC2329
function _clean_up() {
    trap '' INT TERM
    trap - EXIT

    [[ -n "${output_id:-}" ]] && wpctl set-mute "$output_id" 1; sleep 0.1s


    (: >&3) 2>/dev/null && exec 3>&-

    _kill_recursively "${socket_PID:-}"
    _kill_recursively "${loudcomp_node_PID:-}"
    _kill_recursively "${pwcli_handler_PID:-}"
    _kill_recursively "${auto_reload_PID:-}"
    _kill_recursively "${auto_switch_PID:-}"

    if [[ -n "${output_id:-}" ]]; then
        if [[ "${system_transfer:-}" == true ]]; then
            output_volume="$(awk -v input_gain="$global_input_gain" -v raw_volume="$raw_volume" 'BEGIN {printf "%.2f\n", (10 ^ ((input_gain + raw_volume) / 60))}')"
            wpctl set-volume "$output_id" "$output_volume"
            wpctl set-mute "$output_id" "$mute_state"
        fi

        wpctl set-default "$output_id"
    fi

    _disconnect_nodes


    [[ -d "$runtime_dir" ]] && rm "$runtime_dir"/!(state.sock) 2>/dev/null || :
}


function _start_daemon() {
    trap '_clean_up' EXIT
    trap '_clean_up; exit 130' INT
    trap '_clean_up; exit 143' TERM
    trap 'printf "Pipewire exited\n"; _clean_up; exit 1' USR1

    [[ ! -d "$data_dir"    ]] && mkdir -p "$data_dir"
    # shellcheck disable=SC2174
    [[ ! -d "$runtime_dir" ]] && mkdir -p -m 700 "$runtime_dir"

    [[ ! -f "$config_dir/settings.env"        ]] && _create_config "$config_dir/settings.env"
    [[ ! -f "$data_dir/state.env"             ]] && _create_state_file "$data_dir/state.env"
    [[ ! -f "$data_dir/node_ready.lua"        ]] && _create_node_ready_script "$data_dir/node_ready.lua" "$loudcomp_node_description"
    [[ ! -f "$data_dir/get_new_device_id.lua" ]] && _create_device_watcher_script "$data_dir/get_new_device_id.lua" "$loudcomp_node_description"
    [[ ! -f "$data_dir/loudcomp_node.conf"    ]] && _create_loudcomp_node_config "$data_dir/loudcomp_node.conf" "$loudcomp_node_description"


    [[ -d "$runtime_dir" ]] && rm "$runtime_dir"/!(state.sock) 2>/dev/null || :
    printf '%d\n' "$main_pid" > "$runtime_dir/$name.lock"

    mkfifo "$runtime_dir/command_handler"
    exec 3<> "$runtime_dir/command_handler"

    # shellcheck disable=SC1091
    source "$config_dir/settings.env"
    # shellcheck disable=SC1091
    source "$data_dir/state.env"


    if command -v play >/dev/null; then
        sound_available=true

        read -r sound_theme < <(kreadconfig6 --file kdeglobals --group Sounds --key Theme 2>/dev/null) || :

        if [[ -z "${sound_theme:-}" ]]; then
            if [[ "${XDG_CURRENT_DESKTOP:-}" == "KDE" ]]; then
                sound_theme="ocean"
            else
                sound_theme="freedesktop"
            fi
        fi
    elif [[ "$play_sound" == "true" ]]; then
        _print_log "warn" "sox 'play' command not found, no sound will play"
    fi

    _create_loudcomp_node

    sleep 0.1s

    _update_output_info


    last_output_device="$output_name"
    last_output_id="$output_id"
    sanitized_name="${output_name//[-.]/_}"
    custom_input_gain="${sanitized_name}_input_gain"

    if [[ -v "$custom_input_gain" ]]; then
        global_input_gain="${!custom_input_gain}"
        is_custom_input_gain=true
    else
        is_custom_input_gain=false
    fi

    global_input_gain="$((global_input_gain+listening_volume-83))"
    raw_input_gain="$(awk -v input_gain="$global_input_gain" 'BEGIN {printf "%.6f\n", (10 ^ (input_gain / 20))}')"


    read -r _ output_volume _ < <(wpctl get-volume "$output_id")
    _save_state &


    if [[ "${system_transfer:-}" == true ]]; then
        if [[ "$(wpctl get-volume "$output_id")" == *"[MUTED]"* ]]; then
            mute_state=1
        else
            mute_state=0
        fi
    fi


    wpctl set-mute "$output_id" 1
    sleep 0.1s


    if [[ "${system_transfer:-}" == true ]]; then
        raw_volume="$(awk -v output_volume="$output_volume" -v input_gain="$global_input_gain" 'BEGIN {printf "%.0f\n", ((60 * ( log(output_volume) / log(10))) - input_gain)}')"
    else
        printf -v raw_volume '%.0f' "$raw_volume"
    fi

    [[ "$raw_volume" == "-inf" ]] && raw_volume=-83


    volume="$(awk -v raw_volume="$raw_volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.0f", 100 * (10 ^ (raw_volume / (20 * vce)))}' )"

    [[ -z "${highest_volume_limit:-}" || "${highest_volume_limit:-}" -gt 100 ]] && highest_volume_limit=100
    [[ -z "${lowest_volume_limit:-}"  || "${lowest_volume_limit:-}"  -lt 0   ]] && lowest_volume_limit=0

    if [[ "$volume" -gt "$highest_volume_limit" ]]; then
        volume="$highest_volume_limit"
        raw_volume="$(awk -v volume="$volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.6f\n", 20 * log((volume / 100) ^ vce) / log(10)}')"
    fi

    if [[ "$volume" -lt "$lowest_volume_limit"  ]]; then
        volume="$lowest_volume_limit"
        raw_volume="$(awk -v volume="$volume" -v vce="$volume_curve_exponent" 'BEGIN {printf "%.6f\n", 20 * log((volume / 100) ^ vce) / log(10)}')"
    fi


    loudcomp_node_id="$(pw-dump | jq -r '.[] | select(.type=="PipeWire:Interface:Node") | select(.info.props["node.name"]=="effect_input.loudcomp") | .id')"

    _start_pwcli_handler

    sleep 0.05s

    _connect_nodes


    _pwcli_set_param 2 "{ \"params\": [ \"loudcomp:input\", $raw_input_gain, \"loudcomp:mode\", $processing_mode, \"loudcomp:fft\", $fft_quality, \"loudcomp:approx\", $iir_approx, \"loudcomp:std\", $curve, \"loudcomp:hclip\", $is_clipping, \"loudcomp:hcrange\", $clipping_range, \"loudcomp:volume\", $raw_volume ] }"


    wpctl set-default "$loudcomp_node_id"
    wpctl set-volume "$loudcomp_node_id" 1.0
    wpctl set-volume "$output_id" 1.0
    sleep 0.05s

    wpctl set-mute "$output_id" "$mute_state"


    [[ "${auto_reload:-}" == true ]] && _start_auto_reload
    [[ "${auto_switch:-}" == true ]] && _start_auto_switch


    [[ "${is_systemd_used:-}" == true ]] && systemd-notify --ready 2>/dev/null

    _print_log "info" "daemon is running"


    while read -r cmd arg1 arg2; do
        case "$cmd" in
            "set")
                _pwcli_set_param 2 "{ \"params\": [ \"loudcomp:$arg1\", $arg2 ] }"
            ;;
            "_set_relative_input_gain"|"_set_relative_volume"|"_set_input_gain"|"_set_volume"|"_set_mute_state"|"_set_curve_state"|"_stop_daemon"|"_start_socket"|"_stop_socket"|"_send_state"|"_reload"|"_switch")
                ${cmd} "$arg1" "$arg2"
            ;;
            *)
                printf '%s is not a command\n' "$cmd"
            ;;
        esac
    done <&3
}


# shellcheck disable=SC2329
function _stop_daemon() {
    exit 0
}


function _main() {
    name="${0##*/}"
    builtins=("rm" "id" "mkdir" "mkfifo" "sleep")

    for builtin in "${builtins[@]}";do
        if ! enable "$builtin" 2>/dev/null && command -v "$builtin" >/dev/null; then
            _print_message "stderr" "failed to load '${GRAY}${builtin}${RESET}' builtin, falling back to '${MAGENTA}${builtin}${RESET}' binary"
        fi
    done


    [[ -z "${USER:-}" ]] && USER="$(id -run 2>/dev/null)"
    [[ -z "${HOME:-}" ]] && IFS=':' read -r _ _ _ _ _ HOME _ < <(getent passwd "$USER")
    [[ -z "${HOME:-}" ]] && { _print_message "stderr" "Unbound variable" "cannot read 'HOME'"; return 1; }

    main_pid="$$"
    config_dir="${XDG_CONFIG_HOME:-"$HOME/.config"}/$name"
    data_dir="${XDG_DATA_HOME:-"$HOME/.local/share"}/$name"

    if [[ -d "/run/user/$UID" ]]; then
        runtime_dir="${XDG_RUNTIME_DIR:-"/run/user/$UID"}/$name"
    else
        printf 'Runtime directory %b%s%b %bnot found%b, fallback to %b%s%b\n' "$BLUE" "/run/user/$UID" "$RESET" "$RED" "$RESET" "$GRAY" "/tmp/user-$UID" "$RESET"
        runtime_dir="${XDG_RUNTIME_DIR:-"/tmp/user-$UID"}/$name"
    fi

    loudcomp_node_description="LSP Loudness Compensator"
    loudcomp_node_name="${loudcomp_node_description// /-}"
    loudcomp_node_name="${loudcomp_node_name,,}"

    [[ -e "/run/systemd/system" ]] && is_systemd_used=true


    if [[ -z "${PIPEWIRE_RUNTIME_DIR:-}" ]] && [[ -z "${XDG_RUNTIME_DIR:-}" ]]; then
        printf 'Please make sure that %bXDG_RUNTIME_DIR%b or %bPIPEWIRE_RUNTIME_DIR%b are set when starting the daemon\n' "$MAGENTA" "$RESET" "$MAGENTA" "$RESET" >&2
        return 1
    fi


    if ! pw-cli info 0 &>/dev/null; then
        _print_message "stderr" "No such process" "cannot access pipewire"
        return 1
    fi


    case "${1:-}" in
        "--help"|"-h")
            _help "stdout"
            return 0
        ;;
        "start-daemon")
            if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                if [[ "${is_systemd_used:-}" == true ]] && systemctl --user is-active pw-loudcompd.service >/dev/null; then
                    _print_message "stderr" "Daemon already running via systemd service" "cannot start daemon"
                else
                    _print_message "stderr" "Daemon already running" "cannot start daemon"
                fi

                return 1
            else
                _start_daemon
                return "$?"
            fi
        ;;
        "stop-daemon")
            if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                if [[ -t 0 ]] && [[ "${is_systemd_used:-}" == true ]] && systemctl --user is-active pw-loudcompd.service &>/dev/null; then
                    systemctl --user stop pw-loudcompd.service
                    _print_message "stdout" "daemon has been stopped via systemd socket"
                    return 0
                else
                    coproc inotifywait { exec inotifywait -q -m -e delete "$runtime_dir"; }

                    # shellcheck disable=SC2154
                    trap 'kill "${inotifywait_PID:-}" &>/dev/null' INT

                    printf '_stop_daemon\n' > "$runtime_dir/command_handler"

                    while read -r _ _ filename; do
                        if [[ "$filename" == "pw-loudcomp.lock" ]]; then
                            break
                        fi
                    done <&"${inotifywait[0]}"

                    kill "${inotifywait_PID:-}" &>/dev/null

                    sleep 1s

                    [[ "${is_systemd_used:-}" == true ]] && systemd-notify --stopping &>/dev/null
                fi

                return 0
            else
                _print_message "stderr" "No such process" "cannot access daemon"
                return 1
            fi
        ;;
        "start-socket")
            if [[ "${is_systemd_used:-}" == true ]] && systemctl --user is-active pw-loudcomp-socket.socket &>/dev/null; then
                _print_message "stderr" "Socket already running via systemd socket" "cannot start socket"
                return 1
            else
                if [[ -S "$runtime_dir/state.sock" ]]; then
                    _print_message "stderr" "Socket already running" "cannot start socket"
                    return 1
                else
                    _start_socket
                    return 0
                fi
            fi
        ;;
        "_socket_handler")
            _socket_handler
        ;;
        "stop-socket")
            if [[ "${is_systemd_used:-}" == true ]]; then
                if systemctl --user is-active pw-loudcomp-socket.socket &>/dev/null; then
                    systemctl --user stop pw-loudcomp-socket.socket
                    _print_message "stdout" "socket has been stopped via systemd socket"
                    return 0
                else
                    _print_message "stderr" "No such process" "cannot stop socket"
                    return 1
                fi
            else
                if [[ -S "$runtime_dir/state.sock" ]]; then
                    _stop_socket
                    return 0
                else
                    _print_message "stderr" "No such process" "cannot stop socket"
                    return 1
                fi
            fi
        ;;
        "reload")
            if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                printf '_reload\n' > "$runtime_dir/command_handler"
                return 0
            else
                _print_message "stderr" "No such process" "cannot access daemon"
                return 1
            fi
        ;;
        "set-input-gain")
            if [[ -z "${2:-}" ]]; then
                _print_message "stderr" "Invalid argument" "command value not specified"
                _help "stderr"
                return 2
            elif [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                if [[ "$2" =~ ^([0-9]+)%([+-])$ ]]; then
                    printf '_set_relative_input_gain %s %s\n' "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" > "$runtime_dir/command_handler"
                elif [[ "$2" =~ ^(-?[0-9]+)$ ]]; then
                    printf '_set_input_gain %s\n' "$2" > "$runtime_dir/command_handler"
                else
                    _print_message "stderr" "Invalid argument" "'${RED}$2${RESET}'"
                    printf '\n'
                    _help "stderr"
                    return 2
                fi
            else
                _print_message "stderr" "No such process" "cannot access daemon"
                return 1
            fi
        ;;
        "set-volume")
            # shellcheck disable=SC1091
            [[ -f "$config_dir/settings.env" ]] && source "$config_dir/settings.env"
            if [[ -z "${2:-}" ]]; then
                _print_message "stderr" "Invalid argument" "command value not specified"
                printf '\n'
                _help "stderr"
                return 2
            elif [[ "$2" =~ ^([0-9]+)%([+-])$ ]]; then
                if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                    printf "_set_relative_volume %s %s\n" "${BASH_REMATCH[1]}" "${BASH_REMATCH[2]}" > "$runtime_dir/command_handler"
                    return 0
                elif [[ "${system_fallback:-}" == true ]]; then
                    wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ "$2"
                    wpctl set-mute @DEFAULT_AUDIO_SINK@ 0

                    if [[ "$play_sound" == true ]] && [[ "${sound_available:-}" == true ]]; then
                        play "/usr/share/sounds/$sound_theme/stereo/audio-volume-change.oga" 2>/dev/null &
                    fi
                else
                    _print_message "stderr" "No such process" "cannot access daemon"
                    return 1
                fi
            elif [[ "$2" =~ ^(0\.[0-9]+)$ ]]; then
                if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                    printf "_set_volume %s\n" "$(awk -v volume="$2" 'BEGIN {printf "%.0f", volume * 100 }')" > "$runtime_dir/command_handler"
                    return 0
                elif [[ "${system_fallback:-}" == true ]]; then
                    wpctl set-volume -l 1 @DEFAULT_AUDIO_SINK@ "$2"
                    wpctl set-mute @DEFAULT_AUDIO_SINK@ 0

                    if [[ "$play_sound" == true ]] && [[ "${sound_available:-}" == true ]]; then
                        play "/usr/share/sounds/$sound_theme/stereo/audio-volume-change.oga" 2>/dev/null &
                    fi
                else
                    _print_message "stderr" "No such process" "cannot access daemon"
                    return 1
                fi
            else
                if [[ "$2" =~ ^([0-9]+)$ ]]; then
                    _print_message "stderr" "value out of range (0.00 to 1.00)" "'${RED}$2${RESET}'"
                    return 2
                else
                    _print_message "stderr" "Invalid argument" "'${RED}$2${RESET}'"
                    printf '\n'
                    _help "stderr"
                    return 2
                fi
            fi
        ;;
        "set-mute")
            # shellcheck disable=SC1091
            [[ -f "$config_dir/settings.env" ]] && source "$config_dir/settings.env"
            if [[ -f "$runtime_dir/pw-loudcomp.lock" ]] || [[ "${system_fallback:-}" == true ]]; then
                if [[ -z "${2:-}" ]]; then
                    _print_message "stderr" "Invalid argument" "command value not specified"
                    return 2
                elif [[ ! "$2" =~ ^(1|0|toggle)$ ]]; then
                    _print_message "stderr" "Invalid argument" "'${RED}$2${RESET}'"
                    printf '\n'
                    _help "stderr"
                    return 2
                elif [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                    printf '_set_mute_state %s\n' "$2" > "$runtime_dir/command_handler"
                    return 0
                else
                    wpctl set-mute @DEFAULT_AUDIO_SINK@ "$2"
                    wpctl_get_volume="$(wpctl get-volume @DEFAULT_AUDIO_SINK@)"

                    if [[ "${XDG_CURRENT_DESKTOP:-}" == "KDE" ]]; then
                        if [[ "$wpctl_get_volume" == *"[MUTED]"* ]]; then
                            qdbus6 org.kde.plasmashell /org/kde/osdService org.kde.osdService.volumeChanged 0 2>/dev/null &
                        else
                            qdbus6 org.kde.plasmashell /org/kde/osdService org.kde.osdService.volumeChanged "$(awk -v volume="${wpctl_get_volume:8}" 'BEGIN {printf "%.0f\n", volume * 100}')" 2>/dev/null &
                        fi
                    fi
                    return 0
                fi
            else
                _print_message "stderr" "No such process" "cannot access daemon"
                return 1
            fi
        ;;
        "set-curve-state")
            if [[ -z "${2:-}" ]]; then
                _print_message "stderr" "Invalid argument" "command value not specified"
                return 2
            elif [[ "$2" =~ ^(1|0|toggle)$ ]]; then
                if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                    printf '_set_curve_state %s\n' "$2" > "$runtime_dir/command_handler"
                    return 0
                else
                    _print_message "stderr" "No such process" "cannot access daemon"
                    return 1
                fi
            else
                _print_message "stderr" "Invalid argument" "'${RED}$2${RESET}'"
                printf '\n'
                _help "stderr"
                return 2
            fi
        ;;
        "set")
            if [[ -z "${3:-}" ]]; then
                _print_message "stderr" "Invalid argument" "command second value not specified"
                printf '\n'
                _help "stderr"
                return 2
            else
                if [[ -f "$runtime_dir/pw-loudcomp.lock" ]]; then
                    printf 'set %s %s\n' "$2" "$3" > "$runtime_dir/command_handler"
                else
                    _print_message "stderr" "No such process" "cannot access daemon"
                    return 1
                fi
            fi
        ;;
        "create-config")
            _check_config
            return "$?"
        ;;
        "")
            _print_message "stderr" "Invalid argument" "command not specified"
            printf '\n'
            _help "stderr"
            return 2
        ;;
        *)
            _print_message "stderr" "unknown command '${RED}${1}${RESET}'"
            printf '\n'
            _help "stderr"
            return 2
        ;;
    esac
}


_main "$@"
exit "$?"
